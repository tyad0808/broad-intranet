# 이 파일은 "어떤 값이 필요한지" 알려주는 견본입니다. 진짜 값은 넣지 마세요.
# 사용법: 이 파일을 복사해 .env 를 만들고, .env 에만 진짜 값을 넣습니다.
#   cp .env.example .env

# 서버 포트
PORT=3000

# 로그인 세션 암호화용 비밀 문자열 (아무도 모르는 긴 무작위 문자열)
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 주문 데이터 출처: mock(가짜 주문, 개발용), naver(실제 스마트스토어), off(수집 안 함)
ORDER_SOURCE=mock

# 네이버 커머스 API 애플리케이션 정보 (커머스 API센터에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 발주확인·발송처리를 실제로 네이버에 보낼지: on 이면 보냄, 그 밖에는 연습 모드(보내지 않고 기록만)
# ORDER_SOURCE=naver 일 때만 on 이 적용됩니다
NAVER_WRITE=off

# 쿠팡 OPEN API (Wing → 추가판매정보 → OPEN API 키 발급). 세 개가 모두 있으면 쿠팡 주문도 수집 (조회만)
# 잠시 끄려면 COUPANG=off
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 쿠팡 상품준비중 처리·송장 업로드: on 이면 실제로 보냄, 그 밖에는 연습 모드(보내지 않고 기록만)
COUPANG_WRITE=off

# 자사몰 주문 API (broad-quote 의 mall-api, 같은 서버). 키가 있으면 자사몰 주문도 수집. 잠시 끄려면 GODO=off
GODO_API_URL=http://127.0.0.1:3100/mall-api/v1
GODO_API_KEY=
# 자사몰 발주확인·송장 등록: 처리용 키(orders:write 권한, 조회 키와 따로 발급)
# GODO_WRITE=on 이 아니면 연습 모드 (버튼을 눌러도 자사몰로 보내지 않음). 켜면 고객에게 알림톡·SMS 가 실제로 나감
GODO_WRITE_KEY=
GODO_WRITE=

# 주문 자동 수집 간격 (분)
COLLECT_INTERVAL_MINUTES=5

# 4차 문의함: 회사 메일 (계정 비밀번호가 아니라 각 메일에서 발급한 '앱 비밀번호')
# 둘 다 있는 메일만 연결된다. MAIL_SEND=on 이 아니면 답장은 연습 모드 (보내지 않고 기록만)
NAVER_MAIL_USER=
NAVER_MAIL_PASS=
GMAIL_USER=
GMAIL_PASS=
# 같은 종류 메일을 더 연결하려면 번호를 붙인다 (최대 5개씩): NAVER_MAIL2_USER / NAVER_MAIL2_PASS, GMAIL2_USER / GMAIL2_PASS …
# 화면에는 각 메일 주소로 표시된다
MAIL_SEND=
# 답장 보낸 사람 이름 (비우면 '브로애드')
MAIL_FROM_NAME=

# 4-2 스마트스토어 상품문의(Q&A): 실제 스마트스토어(ORDER_SOURCE=naver)면 문의함으로 자동으로 가져온다 (끄려면 NAVER_QNA=off)
# 커머스API센터에서 애플리케이션에 '문의' API 그룹을 추가해야 한다. NAVER_ANSWER=on 이 아니면 답변은 연습 모드
NAVER_QNA=
NAVER_ANSWER=

# 4-3 쿠팡 문의(상품별 고객문의·고객센터 문의): 쿠팡 키가 있으면 문의함으로 가져온다 (끄려면 COUPANG_QNA=off)
# 답변은 COUPANG_ANSWER=on 일 때만 실제로 등록. 누가 답했는지로 WING 로그인 아이디가 필요 (비밀번호 아님)
COUPANG_WING_ID=
COUPANG_QNA=
COUPANG_ANSWER=

# 4-4 자사몰 문의(1:1 문의·상품 문의·견적 문의): 자사몰 수집이 켜져 있으면 문의함으로 가져온다 (끄려면 GODO_QNA=off)
# 조회 키(GODO_API_KEY)에 inquiries, 처리 키(GODO_WRITE_KEY)에 inquiries:write 권한을 견적 프로젝트 쪽에서 더해야 한다
# 답변은 GODO_ANSWER=on 일 때만 실제로 등록 (자사몰 관리자에서 답변한 것과 같아서 고객에게 답변 알림 메일·SMS 가 나갈 수 있음)
GODO_QNA=
GODO_ANSWER=

# 5차 네이버 톡톡 (톡톡 파트너센터 > 개발자도구 > 챗봇 API). 비밀 주소용 글자는 openssl rand -hex 24 로 만든다
# 끄려면 TALKTALK=off. 보내기 API 키는 고객 말이 오면 대화 주도권을 파트너센터로 넘기는 데 쓴다
TALKTALK_WEBHOOK_TOKEN=
TALKTALK_SEND_KEY=
TALKTALK=
# 인트라넷에서 톡톡 답장(글·사진)을 실제로 보내려면 on (아니면 연습 모드: 기록만). 사진은 PUBLIC_URL 주소로 네이버가 잠깐 가져간다
TALKTALK_ANSWER=

# 로젠택배 송장 발행 (로젠 개발자 사이트 openapihome.ilogen.com '이용안내 > 신청등록 / 인증키발급' 에서 서버 IP 등록 후 발급)
# LOGEN_ENV=prod 가 아니면 테스트 서버(개발계). 실제 로젠 등록은 LOGEN_WRITE=on 일 때만
LOGEN_SECRET_KEY=
LOGEN_CUST_CD=
LOGEN_USER_ID=
LOGEN_ENV=
LOGEN_WRITE=
