# 이 파일은 "어떤 값이 필요한지" 알려주는 견본입니다. 진짜 값은 넣지 마세요.
# 사용법: 이 파일을 복사해 .env 를 만들고, .env 에만 진짜 값을 넣습니다.
#   cp .env.example .env

# 서버 포트
PORT=3000

# 로그인 세션 암호화용 비밀 문자열 (아무도 모르는 긴 무작위 문자열)
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 주문 데이터 출처: mock(가짜 주문, 개발용), naver(실제 스마트스토어), off(수집 안 함)
ORDER_SOURCE=mock

# 네이버 커머스 API 애플리케이션 정보 (커머스 API센터에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 발주확인·발송처리를 실제로 네이버에 보낼지: on 이면 보냄, 그 밖에는 연습 모드(보내지 않고 기록만)
# ORDER_SOURCE=naver 일 때만 on 이 적용됩니다
NAVER_WRITE=off

# 쿠팡 OPEN API (Wing → 추가판매정보 → OPEN API 키 발급). 세 개가 모두 있으면 쿠팡 주문도 수집 (조회만)
# 잠시 끄려면 COUPANG=off
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 쿠팡 상품준비중 처리·송장 업로드: on 이면 실제로 보냄, 그 밖에는 연습 모드(보내지 않고 기록만)
COUPANG_WRITE=off

# 자사몰 주문 API (broad-quote 의 mall-api, 같은 서버). 키가 있으면 자사몰 주문도 수집. 잠시 끄려면 GODO=off
GODO_API_URL=http://127.0.0.1:3100/mall-api/v1
GODO_API_KEY=
# 자사몰 발주확인·송장 등록: 처리용 키(orders:write 권한, 조회 키와 따로 발급)
# GODO_WRITE=on 이 아니면 연습 모드 (버튼을 눌러도 자사몰로 보내지 않음). 켜면 고객에게 알림톡·SMS 가 실제로 나감
GODO_WRITE_KEY=
GODO_WRITE=

# 주문 자동 수집 간격 (분)
COLLECT_INTERVAL_MINUTES=5
