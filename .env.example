# 이 파일은 "어떤 값이 필요한지" 알려주는 견본입니다. 진짜 값은 넣지 마세요.
# 사용법: 이 파일을 복사해 .env 를 만들고, .env 에만 진짜 값을 넣습니다.
#   cp .env.example .env

# 서버 포트
PORT=3000

# 로그인 세션 암호화용 비밀 문자열 (아무도 모르는 긴 무작위 문자열)
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 주문 데이터 출처: mock(가짜 주문, 개발용) 또는 naver(실제 스마트스토어)
ORDER_SOURCE=mock

# 네이버 커머스 API 애플리케이션 정보 (커머스 API센터에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 주문 자동 수집 간격 (분)
COLLECT_INTERVAL_MINUTES=5

# ───────── 시안 컨펌 ─────────
# 고객에게 보내는 링크의 주소 (서버에 올린 뒤 실제 도메인으로. 예: https://intranet.broad.co.kr)
PUBLIC_BASE_URL=
# 고객 링크 사용 기간 (일). 수정 시안을 올리면 다시 이 기간으로 늘어난다
PROOF_EXPIRE_DAYS=30

# 문자 발송: mock(가짜 발송, 개발용) 또는 aligo(실제 발송)
SMS_DRIVER=mock
# 알리고 → [API 연동] 에서 발급. 알리고에 이 서버의 IP 를 등록해야 발송된다
ALIGO_API_KEY=
ALIGO_USER_ID=
# 알리고에 등록된 발신번호 (매장 번호)
ALIGO_SENDER=
# Y 로 하면 알리고 테스트 모드 (실제로 문자가 가지 않고 요금도 나가지 않음)
ALIGO_TEST_MODE=N
# 고객이 확정 / 수정 요청하면 문자를 받을 번호 (쉼표로 여러 개)
PROOF_NOTIFY_PHONES=
