          <ScriptPath>./jsx/dombo-core.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>브로애드 도구</Menu>
          <Geometry>
            <Size><Height>660</Height><Width>280</Width></Size>
            <MinSize><Height>360</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
