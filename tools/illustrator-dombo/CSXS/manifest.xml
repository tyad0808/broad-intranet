<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.broad.dombo" ExtensionBundleVersion="1.14.0"
  ExtensionBundleName="Broad Dombo" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.broad.dombo.panel" Version="1.14.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- 일러스트레이터 CC 2017(21) 이상 -->
      <Host Name="ILST" Version="[21.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="7.0" />
    </RequiredRuntimeList>
