<%- include('../partials/header') %>
<%# 고객용 시안확정서 만들기: 왼쪽 칸을 채우면 오른쪽 A4 미리보기가 바로 바뀌고, 그대로 JPG 로 저장한다.
    넣은 그림·글자는 이 화면에서만 쓰고 서버에는 저장하지 않는다 (proof-maker.js) %>
<% const d = makerData; %>
<div class="page-head sticky-glass">
  <div class="title-row maker-head">
    <h1 class="page-title">고객용 시안확정서 만들기</h1>
    <div class="page-actions">
      <% if (d.orderId) { %><a class="btn-sm ghost" href="/orders/<%= d.orderId %>#proof">← 주문으로</a><% } else if (back !== '/') { %><a class="btn-sm ghost" href="<%= back %>">← 돌아가기</a><% } %>
      <button type="button" class="btn-sm" data-maker-print>인쇄</button>
      <button type="button" class="btn-sm primary" data-maker-save>JPG로 저장</button>
    </div>
  </div>
</div>

<div class="maker">
  <form class="card maker-form" data-maker-form autocomplete="off">
    <div class="maker-drop" data-maker-drop tabindex="0" role="button" aria-label="시안 그림 고르기">
      <strong>시안 그림을 끌어다 놓거나 Ctrl+V 로 붙여 넣으세요</strong>
      <span class="muted small">눌러서 고를 수도 있어요 · PNG·JPG·WEBP · 서버에 올라가지 않아요</span>
      <span class="maker-file muted small" data-maker-file><%= d.imageUrl ? '주문에 올려 둔 시안을 넣었어요' : '' %></span>
    </div>
    <input type="file" accept="image/png,image/jpeg,image/webp" data-maker-input hidden>

    <div class="two-fields">
      <label><span class="cap">구매처</span><input type="text" name="channel" value="<%= d.channel || '' %>" maxlength="40" placeholder="예: 스마트스토어"></label>
      <label><span class="cap">주문번호</span><input type="text" name="orderNo" value="<%= d.orderNo || '' %>" maxlength="40"></label>
    </div>
    <div class="two-fields">
      <label><span class="cap">구매자</span><input type="text" name="buyer" value="<%= d.buyer || '' %>" maxlength="30"></label>
      <label><span class="cap">수령자 <span class="muted small">(구매자와 다를 때)</span></span><input type="text" name="receiver" value="<%= d.receiver || '' %>" maxlength="30"></label>
    </div>
    <div class="two-fields">
      <label><span class="cap">담당 디자이너 <span class="muted small">(별명)</span></span><input type="text" name="designer" value="<%= d.designer || '' %>" maxlength="30"></label>
      <label><span class="cap">수정 횟수</span><input type="number" name="revision" value="<%= d.revision || 0 %>" min="0" max="999" inputmode="numeric"></label>
    </div>
    <% if (d.designerNote) { %><p class="maker-note"><%= d.designerNote %></p><% } %>
    <label><span class="cap">연락처</span><input type="text" name="phone" value="<%= d.phone || '' %>" maxlength="30"></label>
    <label><span class="cap">상품 <span class="muted small">(상품마다 첫 줄 = 이름 × 수량, 다음 줄 = 옵션 · 상품 사이는 빈 줄)</span></span><textarea name="products" rows="6" maxlength="1500" placeholder="예: 실물 등신대 포맥스3T 1인 × 1&#10;등신대 키 선택: ~180cm · 거치대 선택: 거치대O"><%= d.products || '' %></textarea>
    </label>
    <label><span class="cap">추가옵션 <span class="muted small">(한 줄에 하나씩 · 괄호 안은 연한 글씨)</span></span><textarea name="addons" rows="3" maxlength="600" placeholder="예: 볼터치작업 × 1 (볼터치 무료옵션)"><%= d.addons || '' %></textarea>
    </label>
    <label><span class="cap">고객 요청</span>
      <textarea name="requests" rows="3" maxlength="600"><%= d.requests || '' %></textarea>
    </label>
    <p class="muted small">여기서 고친 글자는 이 시안확정서에만 쓰여요. 주문 정보는 바뀌지 않아요.</p>
  </form>

  <div class="maker-preview card">
    <canvas data-maker-canvas width="1654" height="2339" aria-label="시안확정서 미리보기"></canvas>
  </div>
</div>

<%# 화면이 그릴 때 쓰는 값 (실행되지 않는 데이터 칸) %>
<script type="application/json" id="maker-data"><%- JSON.stringify(makerData).replace(/</g, '\\u003c') %></script>
<script src="/proof-maker.js"></script>
<%- include('../partials/footer') %>
