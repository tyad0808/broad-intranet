<%- include('../partials/header') %>
<%
  // 지금 걸린 필터를 유지한 채 하나만 바꾼 주소를 만든다
  const link = changes => {
    const p = new URLSearchParams();
    const merged = { view, ch: channel, stage: stageFilter || '', sort: sort === 'recent' ? '' : sort, q, ...changes };
    for (const [k, v] of Object.entries(merged)) if (v) p.set(k, v);
    const s = p.toString();
    return s ? `/?${s}` : '/';
  };
%>

<div class="list-head">
  <h1 class="page-title">주문</h1>
  <% if (channels.length > 0) { %>
    <nav class="channel-chips" aria-label="채널">
      <a href="<%= link({ ch: '' }) %>" class="chip <%= channel ? '' : 'on' %>">전체 채널</a>
      <% channels.forEach(key => { const c = channelInfo(key); %>
        <a href="<%= link({ ch: key }) %>" class="chip <%= channel === key ? 'on' : '' %>">
          <span class="ch ch-<%= c.cls %>"><%= c.mark %></span><%= c.name %>
        </a>
      <% }) %>
    </nav>
  <% } %>
</div>

<nav class="tabs" id="live-tabs">
  <% Object.entries(VIEWS).forEach(([key, label]) => { %>
    <a href="<%= link({ view: key === 'active' ? '' : key }) %>" class="<%= view === key ? 'on' : '' %>">
      <%= label %> <span class="count"><%= counts[key] || 0 %></span>
    </a>
  <% }) %>
</nav>

<form method="get" action="/" class="filters" data-autosubmit>
  <% if (view !== 'active') { %><input type="hidden" name="view" value="<%= view %>"><% } %>
  <% if (channel) { %><input type="hidden" name="ch" value="<%= channel %>"><% } %>
  <select name="stage" aria-label="작업 단계">
    <option value="">모든 단계</option>
    <% stages.forEach(s => { %>
      <option value="<%= s.id %>" <%= stageFilter === s.id ? 'selected' : '' %>><%= s.name %><%= s.active ? '' : ' (숨김)' %></option>
    <% }) %>
  </select>
  <select name="sort" aria-label="정렬">
    <option value="">최근 주문순</option>
    <option value="due" <%= sort === 'due' ? 'selected' : '' %>>납기 임박순</option>
  </select>
  <input type="search" name="q" value="<%= q %>" placeholder="상품, 고객, 주문번호, 메모 검색" aria-label="검색">
  <button type="submit" class="btn-sm">검색</button>
</form>

<div id="live-list">
<% if (groups.length === 0) { %>
  <section class="card"><p class="muted">조건에 맞는 주문이 없습니다.</p></section>
<% } else { %>
  <ul class="order-list">
    <% groups.forEach(g => {
         const o = g.main;
         const c = channelInfo(o.channel);
         const due = dueInfo(o.due_date, today);
         const keepCurrent = o.assignee_id && !designers.some(d => d.id === o.assignee_id);
         const confirmed = g.items.every(i => i.channel_confirmed);
    %>
      <li id="o<%= o.id %>" class="order-item">
        <a class="oi-main" href="/orders/<%= o.id %>?back=<%= encodeURIComponent(currentUrl) %>">
          <div class="oi-head">
            <span class="ch ch-<%= c.cls %>" title="<%= c.name %>"><%= c.mark %></span>
            <span class="muted"><%= o.receiver_name || o.buyer_name || '-' %> · <%= kst(o.paid_at) %> 결제<% if (g.items.length > 1) { %> · 상품 <%= g.items.length %>개<% } %></span>
          </div>
          <ul class="oi-items">
            <% g.items.forEach(i => { %>
              <li class="<%= i.item_type === 'addon' ? 'addon' : '' %>">
                <% if (i.item_type === 'addon') { %><span class="tag">추가</span><% } %>
                <span class="oi-name"><%= i.product_name %></span>
                <div class="muted"><%= i.option_text || '' %><%= i.option_text ? ' · ' : '' %><%= i.quantity %>개</div>
              </li>
            <% }) %>
          </ul>
        </a>
        <div class="oi-meta">
          <span class="pill stage"><%= o.stage_name || '단계 없음' %></span>
          <form method="post" action="/orders/<%= o.id %>/assign" class="inline" data-autosubmit>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= currentUrl %>">
            <select name="assignee_id" class="assign-select <%= o.assignee_id ? '' : 'unassigned' %>" aria-label="담당 디자이너">
              <option value="">미지정</option>
              <% if (keepCurrent) { %><option value="<%= o.assignee_id %>" selected><%= o.assignee_name %></option><% } %>
              <% designers.forEach(d => { %>
                <option value="<%= d.id %>" <%= d.id === o.assignee_id ? 'selected' : '' %>><%= d.name %><%= d.id === user.id ? ' (나)' : '' %></option>
              <% }) %>
            </select>
            <noscript><button type="submit" class="btn-sm">지정</button></noscript>
          </form>
          <% if (due.text) { %><span class="pill <%= due.cls %>">납기 <%= due.text %></span><% } %>
          <span class="pill light"><%= channelStatusLabel(o.channel_status) %><%= confirmed ? ' · 발주확인됨' : '' %></span>
        </div>
      </li>
    <% }) %>
  </ul>
  <% if (groups.length >= 300) { %><p class="muted">최근 300건까지만 보입니다. 검색이나 필터로 좁혀 보세요.</p><% } %>
<% } %>
</div>

<script src="/orders.js"></script>
<%- include('../partials/footer') %>
