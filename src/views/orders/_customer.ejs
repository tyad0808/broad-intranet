<%# 직접 등록한 주문의 상품·고객 칸 (등록, 상세 공통) %>
<label>상품
  <input type="text" name="product_name" value="<%= o.product_name || '' %>" maxlength="200" required placeholder="예: 현수막">
</label>
<div class="grid2">
  <label>규격·옵션
    <input type="text" name="option_text" value="<%= o.option_text || '' %>" maxlength="300" placeholder="예: 5000×900 / 타폴린">
  </label>
  <label>수량
    <input type="number" name="quantity" value="<%= o.quantity || 1 %>" min="1" max="99999" inputmode="numeric">
  </label>
</div>
<div class="grid2">
  <label>고객명 (업체명)
    <input type="text" name="buyer_name" value="<%= o.buyer_name || '' %>" maxlength="100" required>
  </label>
  <label>전화번호
    <input type="tel" name="receiver_phone" value="<%= o.receiver_phone || '' %>" maxlength="30" placeholder="010-0000-0000">
  </label>
</div>
<label>주소 (배송할 때)
  <input type="text" name="receiver_address" value="<%= o.receiver_address || '' %>" maxlength="300">
</label>
