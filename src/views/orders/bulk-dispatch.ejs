<%- include('../partials/header') %>
<p><a href="<%= back %>">← 목록으로</a></p>

<section class="card">
  <h1>일괄 발송처리 (<%= rows.length %>건)</h1>
  <% if (actionMode === 'practice') { %>
    <p class="practice-note"><strong>연습 모드</strong> 보내기를 눌러도 네이버로 보내지 않고 기록만 남깁니다.</p>
  <% } %>
  <p class="muted">주문마다 배송 방법과 송장번호를 넣고 맨 아래 <strong>발송처리 보내기</strong>를 누르세요. 한 줄이라도 틀리면 아무것도 보내지 않습니다.</p>
  <% if (skipped.length) { %>
    <p class="warn-box">발송처리할 수 없어 뺀 주문 <%= skipped.length %>건: <%= skipped.slice(0, 5).join(', ') %><%= skipped.length > 5 ? ' 외' : '' %> (발주확인 전이거나 이미 발송됨)</p>
  <% } %>

  <form method="post" action="/orders/bulk/dispatch" data-once
        data-confirm="<%= rows.length %>건을 입력한 송장으로 발송처리할까요?&#10;고객에게 발송 알림이 가고, 되돌리기 어렵습니다.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="<%= back %>">
    <div class="ship-rows">
      <% rows.forEach(({ main, items }, n) => { const id = main.id; %>
        <div class="ship-row">
          <input type="hidden" name="ids" value="<%= id %>">
          <div class="ship-order">
            <strong><%= n + 1 %>. <%= main.product_name %></strong><% if (items.length > 1) { %> <span class="muted">외 <%= items.length - 1 %>개</span><% } %>
            <div class="muted small"><%= main.receiver_name || '-' %> · <%= main.receiver_address || '' %></div>
          </div>
          <div class="ship-inputs">
            <select name="method_<%= id %>" data-ship-method aria-label="배송 방법">
              <% Object.entries(SHIP_METHODS).forEach(([code, label]) => { %>
                <option value="<%= code %>" <%= code === DEFAULT_METHOD ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
            <span data-ship-fields class="ship-fields">
              <select name="company_<%= id %>" aria-label="택배사">
                <% Object.entries(COURIERS).forEach(([code, label]) => { %>
                  <option value="<%= code %>" <%= code === DEFAULT_COURIER ? 'selected' : '' %>><%= label %></option>
                <% }) %>
              </select>
              <input type="text" name="tracking_<%= id %>" inputmode="numeric" autocomplete="off" maxlength="40" placeholder="송장번호" aria-label="송장번호">
            </span>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit">발송처리 보내기</button>
      <a class="btn-sm" href="<%= back %>">취소</a>
    </div>
  </form>
</section>
<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<%- include('../partials/footer') %>
