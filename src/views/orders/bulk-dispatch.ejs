<%- include('../partials/header') %>
<% if (!locals.embed) { %><p class="back-row"><a href="<%= back %>" class="btn-back">← 목록으로</a></p><% } %>

<section class="card">
  <h1>일괄 발송처리 (<%= rows.length %>건)</h1>
  <% const practice = [...new Set(rows.map(r => r.main.channel))].filter(ch => actionModes[ch] !== 'live'); %>
  <% if (practice.length) { %>
    <p class="practice-note"><strong>연습 모드</strong> <%= practice.map(ch => channelInfo(ch).name).join(' · ') %> 주문은 보내기를 눌러도 보내지 않고 기록만 남깁니다.</p>
  <% } %>
  <p class="muted">주문마다 배송 방법과 송장번호를 넣고 맨 아래 <strong>발송처리 보내기</strong>를 누르세요. 한 줄이라도 틀리면 아무것도 보내지 않습니다.</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (notice) { %><p class="<%= notice.type === 'error' ? 'error' : notice.type === 'ok' ? 'notice' : 'warn-box' %>"><%= notice.message %></p><% } %>
  <%# 로젠에 등록만 하고 아직 출력 전인 주문: 송장번호가 없다 → iLOGEN 에서 출력한 뒤 여기서 가져오기 %>
  <% const waiting = rows.filter(r => r.waiting); %>
  <% if (waiting.length) { %>
    <form method="post" action="/orders/bulk/dispatch-form" class="logen-bar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="back" value="<%= back %>">
      <input type="hidden" name="refresh_slips" value="1">
      <% rows.forEach(r => { %><input type="hidden" name="ids" value="<%= r.main.id %>"><% }) %>
      <span class="logen-bar-text"><span>로젠 <strong>출력 대기 <%= waiting.length %>건</strong>은 아직 송장번호가 없어요</span><span class="muted small">송장번호는 iLOGEN '주문등록출력(복수건)'에서 <strong>출력할 때</strong> 생겨요. 출력한 뒤 [송장번호 가져오기]를 누르면 아래 칸에 채워져요.</span></span>
      <span class="logen-bar-actions">
        <a class="btn-sm" href="https://logis.ilogen.com" target="_blank" rel="noopener">iLOGEN 출력 화면 열기 ↗</a>
        <button type="submit" class="btn-sm">송장번호 가져오기</button>
      </span>
    </form>
  <% } %>
  <% if (skipped.length) { %>
    <p class="warn-box">발송처리할 수 없어 뺀 주문 <%= skipped.length %>건: <%= skipped.slice(0, 5).join(', ') %><%= skipped.length > 5 ? ' 외' : '' %> (발주확인 전이거나 이미 발송됨)</p>
  <% } %>

  <form method="post" action="/orders/bulk/dispatch" data-once
        data-confirm="<%= rows.length %>건을 입력한 송장으로 발송처리할까요?&#10;고객에게 발송 알림이 가고, 되돌리기 어렵습니다.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="<%= back %>">
    <div class="ship-rows">
      <% rows.forEach(({ main, items, slip, waiting }, n) => { const id = main.id; %>
        <div class="ship-row">
          <input type="hidden" name="ids" value="<%= id %>">
          <div class="ship-order">
            <strong><%= n + 1 %>. <span class="ch ch-<%= channelInfo(main.channel).cls %>"><%= channelInfo(main.channel).mark %></span> <%= main.product_name %></strong><% if (items.length > 1) { %> <span class="muted">외 <%= items.length - 1 %>개</span><% } %>
            <div class="muted small"><%= main.receiver_name || '-' %> · <%= main.receiver_address || '' %></div>
            <% if (waiting) { %><span class="st-badge sb-ready ship-wait">🖨 로젠 출력 대기 · 송장번호 없음</span><% } %>
          </div>
          <div class="ship-inputs">
            <%- include('../partials/ship-pick', { inline: true, suffix: `_${id}`, onlyDelivery: main.channel === 'coupang',
                 method: values[`method_${id}`], company: values[`company_${id}`] || (slip ? 'KGB' : undefined), tracking: values[`tracking_${id}`] || slip || '' }) %>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit">발송처리 보내기</button>
      <% if (locals.embed) { %><button type="button" class="btn-sm" data-close-modal>취소</button><% } else { %><a class="btn-sm" href="<%= back %>">취소</a><% } %>
    </div>
  </form>
</section>
<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<%- include('../partials/footer') %>
