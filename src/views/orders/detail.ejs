<%- include('../partials/header') %>
<% if (!locals.embed) { %>
  <p class="back-row"><a href="<%= back %>" class="btn-back">← 목록으로</a></p>
<% } %>

<div class="detail" data-order-id="<%= order.id %>">
  <section class="card">
    <% const c = channelInfo(order.channel); %>
    <p class="detail-channel"><span class="ch ch-<%= c.cls %>"><%= c.mark %></span><%= c.name %> · 주문번호 <%= order.channel_order_id %></p>
    <% claimItems.forEach(i => { const level = claimLevel(i.claim_status); if (!level) return; %>
      <p class="claim-box <%= level === 'done' ? 'done' : '' %>">
        <strong><%= claimLabel(i.claim_status) %></strong>
        <%= i.product_name %><%= level === 'open' ? ` — ${order.channel === 'godo' ? '자사몰 관리자' : order.channel === 'coupang' ? '쿠팡 WING' : '판매자센터'}에서 먼저 처리하세요. 처리 전에는 발주확인·발송처리를 막아 둡니다.` : '' %>
      </p>
    <% }) %>
    <ul class="oi-items detail-items">
      <% items.forEach(i => { %>
        <li class="<%= i.item_type === 'addon' ? 'addon' : '' %>">
          <% if (i.item_type === 'addon') { %><span class="tag">추가</span><% } %>
          <span class="oi-name <%= i.item_type === 'addon' ? '' : 'detail-title' %>"><%= i.product_name %></span>
          <div class="muted"><%= i.option_text || '' %><%= i.option_text ? ' · ' : '' %><%= i.quantity %>개</div>
        </li>
      <% }) %>
    </ul>
    <% if (items.length > 1) { %><p class="muted">아래 내용은 이 주문의 상품 <%= items.length %>개에 함께 저장됩니다.</p><% } %>

    <form method="post" action="/orders/<%= order.id %>" class="detail-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="version" value="<%= order.version %>">
      <input type="hidden" name="back" value="<%= back %>">

      <div class="two-fields">
        <label>주문 단계 <span class="muted small">(자동)</span>
          <% if (user.role === 'admin') { %>
            <select name="stage_id">
              <% stages.forEach(s => { if (!s.active && s.id !== order.stage_id) return; %>
                <option value="<%= s.id %>" <%= s.id === order.stage_id ? 'selected' : '' %>><%= s.name %><%= s.active ? '' : ' (숨김)' %></option>
              <% }) %>
            </select>
          <% } else { %>
            <span class="readonly-value"><%= order.stage_name || '단계 없음' %></span>
          <% } %>
        </label>
        <label>디자인 단계
          <% if (canPickStage) { %>
            <select name="design_stage_id">
              <% designStages.forEach(s => { if (!s.active && s.id !== currentDesignId) return; %>
                <option value="<%= s.id %>" <%= s.id === currentDesignId ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          <% } else { %>
            <span class="readonly-value"><%= (designStages.find(s => s.id === currentDesignId) || {}).name || '-' %> <span class="muted small">(디자이너만 변경)</span></span>
          <% } %>
        </label>
      </div>

      <label>담당 디자이너
        <select name="assignee_id" class="<%= staffColor(order.assignee_id) %>">
          <option value="">미지정</option>
          <% if (order.assignee_id && !designers.some(d => d.id === order.assignee_id)) { %>
            <option value="<%= order.assignee_id %>" selected><%= order.assignee_name %> (디자이너 아님)</option>
          <% } %>
          <% designers.forEach(d => { %>
            <option value="<%= d.id %>" <%= d.id === order.assignee_id ? 'selected' : '' %>><%= d.name %><%= d.id === user.id ? ' (나)' : '' %></option>
          <% }) %>
        </select>
      </label>

      <label>납기
        <input type="date" name="due_date" value="<%= order.due_date || '' %>">
      </label>

      <label>파일 위치 (NAS 경로)
        <input type="text" name="nas_path" value="<%= order.nas_path || '' %>" maxlength="300" placeholder="예: \\NAS\작업\2026\10\홍길동_명함">
      </label>

      <label>메모
        <textarea name="memo" rows="4" maxlength="2000" placeholder="작업 요청사항, 고객과 통화 내용 등"><%= order.memo || '' %></textarea>
      </label>

      <div class="form-actions">
        <button type="submit">저장</button>
        <% if (isDesigner && order.assignee_id !== user.id) { %>
          <button type="submit" name="assignee_id" value="me" class="secondary">내가 맡기</button>
        <% } %>
      </div>
    </form>
  </section>

  <div class="detail-side">
  <% if (['smartstore', 'coupang', 'godo'].includes(order.channel)) {
       const isCoupang = order.channel === 'coupang';
       // 쿠팡·자사몰의 발주확인 = 상품준비중 처리
       const isPrep = isCoupang || order.channel === 'godo'; %>
  <section class="card process-card">
    <h2><%= channelInfo(order.channel).name %> 처리</h2>
    <% if (order.channel === 'godo') { %>
      <p class="muted small">자사몰 관리자에서 처리한 것과 똑같이 고객에게 알림톡·SMS 가 나갑니다. 자사몰 관리자에서 직접 처리해도 5분 안에 여기 상태가 바뀝니다.</p>
    <% } %>
    <% if (actionModes[order.channel] !== 'live') { %>
      <p class="practice-note"><strong>연습 모드</strong> 버튼을 눌러도 <%= WRITE_CHANNEL_NAMES[order.channel] %> 보내지 않고 기록만 남깁니다.</p>
    <% } %>
    <% const allConfirmed = items.every(i => i.channel_confirmed); %>
    <ol class="steps">
      <li class="<%= allConfirmed ? 'done' : '' %>">발주확인 <span><%= allConfirmed ? '완료' : canConfirm ? '대기' : '-' %></span></li>
      <li class="<%= shipped ? 'done' : '' %>">발송처리 <span><%= shipped ? '완료' : canDispatch ? '대기' : '-' %></span></li>
    </ol>

    <% if (canConfirm) { %>
      <form method="post" action="/orders/<%= order.id %>/confirm" data-once
            data-confirm="'<%= items[0].product_name %>' 주문을 <%= channelInfo(order.channel).name %>에 <%= isPrep ? '상품준비중(발주확인)으로' : '발주확인' %> 처리할까요?&#10;고객에게 알림이 가고, 되돌릴 수 없습니다.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="wide"><%= isPrep ? '발주확인 (상품준비중) 보내기' : '발주확인 보내기' %></button>
      </form>
    <% } %>

    <% if (canDispatch) { %>
      <form method="post" action="/orders/<%= order.id %>/dispatch" class="dispatch-form" data-once
            data-confirm="{ship} 로 발송처리할까요?&#10;고객에게 발송 알림이 가고, 되돌리기 어렵습니다.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <label>배송 방법
          <select name="method" data-ship-method>
            <% Object.entries(SHIP_METHODS).forEach(([code, label]) => { if (isCoupang && code !== 'DELIVERY') return; %>
              <option value="<%= code %>" <%= code === DEFAULT_METHOD ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
          <% if (isCoupang) { %><span class="muted small">쿠팡은 택배(송장번호)로만 발송처리됩니다.</span><% } %>
        </label>
        <div data-ship-fields>
          <label>택배사
            <select name="company">
              <% Object.entries(COURIERS).forEach(([code, label]) => { %>
                <option value="<%= code %>" <%= code === DEFAULT_COURIER ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label>송장번호
            <input type="text" name="tracking" inputmode="numeric" autocomplete="off" maxlength="40" placeholder="숫자만 (- 는 빼도 됨)">
          </label>
        </div>
        <button type="submit" class="wide">발송처리 보내기</button>
      </form>
    <% } else if (canConfirm) { %>
      <p class="muted">발주확인을 하면 송장 입력 칸이 나타납니다.</p>
    <% } else if (!shipped) { %>
      <p class="muted">지금은 처리할 수 있는 상품이 없습니다 (결제완료가 아니거나 취소·반품 요청 중).</p>
    <% } %>

    <% if (shipped) { %>
      <p class="shipped-line">
        <%= shipMethodLabel(shipped.ship_method) %><% if (shipped.ship_company) { %> · <%= courierLabel(shipped.ship_company) %> <%= shipped.tracking_no %><% } %>
        <span class="muted">(<%= kst(shipped.shipped_at) %>)</span>
      </p>
    <% } %>

    <% if (history.length) { %>
      <h3>처리 기록</h3>
      <ul class="history">
        <% history.forEach(h => { %>
          <li>
            <span class="result r-<%= h.result %>"><%= RESULT_LABELS[h.result] %></span>
            <%= ACTION_LABELS[h.action] || h.action %>
            <span class="muted">· <%= h.user_name || '-' %> · <%= kst(h.created_at) %></span>
            <% if (h.result !== 'ok' || h.mode === 'local') { %><div class="muted small"><%= h.message %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <% } else if (order.channel === 'manual') { %>
  <% const st = order.channel_status; const editUrl = `/orders/${order.id}/manual-edit${back !== '/' ? `?back=${encodeURIComponent(back)}` : ''}`; %>
  <section class="card process-card">
    <h2>수기 주문</h2>
    <ol class="steps">
      <li class="<%= st !== 'PAYMENT_WAITING' && st !== 'CANCELED' ? 'done' : '' %>">입금 <span><%= st === 'PAYMENT_WAITING' ? '대기' : st === 'CANCELED' ? '-' : '완료' %></span></li>
      <li class="<%= st === 'DELIVERED' ? 'done' : '' %>">발송 <span><%= st === 'DELIVERED' ? '완료' : st === 'CANCELED' ? '-' : '대기' %></span></li>
    </ol>
    <% if (st === 'CANCELED') { %><p class="claim-box"><strong>취소된 주문</strong></p><% } %>
    <dl class="info manual-pay">
      <dt>결제 방법</dt><dd><%= PAY_METHODS[order.pay_method] || '-' %></dd>
      <dt>금액</dt><dd><%= order.amount != null ? `${Number(order.amount).toLocaleString('ko-KR')}원` : '-' %></dd>
      <dt>입금자명</dt><dd><%= order.depositor || order.buyer_name || '-' %></dd>
    </dl>

    <% if (st === 'PAYMENT_WAITING') { %>
      <form method="post" action="/orders/<%= order.id %>/manual/paid" data-once
            data-confirm="<%= order.depositor || order.buyer_name %> 님 입금을 확인했나요?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="wide">입금 확인</button>
      </form>
    <% } %>

    <% if (st === 'PAYED' || st === 'PAYMENT_WAITING') { %>
      <form method="post" action="/orders/<%= order.id %>/manual/dispatch" class="dispatch-form" data-once
            data-confirm="{ship} 로 발송 완료 기록할까요?<%= st === 'PAYMENT_WAITING' ? '&#10;※ 아직 입금대기 상태입니다.' : '' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <label>배송 방법
          <select name="method" data-ship-method>
            <% Object.entries(SHIP_METHODS).forEach(([code, label]) => { %>
              <option value="<%= code %>" <%= code === DEFAULT_METHOD ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
        </label>
        <div data-ship-fields>
          <label>택배사
            <select name="company">
              <% Object.entries(COURIERS).forEach(([code, label]) => { %>
                <option value="<%= code %>" <%= code === DEFAULT_COURIER ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label>송장번호
            <input type="text" name="tracking" inputmode="numeric" autocomplete="off" maxlength="40" placeholder="숫자만 (- 는 빼도 됨)">
          </label>
        </div>
        <button type="submit" class="wide secondary">발송 완료 기록</button>
      </form>
      <p class="muted small">수기 주문은 인트라넷에만 기록됩니다. 고객 안내(문자 등)는 따로 해 주세요.</p>
    <% } %>

    <% if (shipped) { %>
      <p class="shipped-line">
        <%= shipMethodLabel(shipped.ship_method) %><% if (shipped.ship_company) { %> · <%= courierLabel(shipped.ship_company) %> <%= shipped.tracking_no %><% } %>
        <span class="muted">(<%= kst(shipped.shipped_at) %>)</span>
      </p>
    <% } %>

    <div class="form-actions manual-actions">
      <a class="btn-sm" href="<%= editUrl %>">주문 정보 수정</a>
      <% if (st !== 'CANCELED') { %>
        <form method="post" action="/orders/<%= order.id %>/manual/cancel" class="inline" data-once
              data-confirm="이 수기 주문을 취소할까요?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= back %>">
          <button type="submit" class="btn-sm danger">주문 취소</button>
        </form>
      <% } %>
    </div>

    <% if (history.length) { %>
      <h3>처리 기록</h3>
      <ul class="history">
        <% history.forEach(h => { %>
          <li>
            <span class="result r-<%= h.result %>"><%= RESULT_LABELS[h.result] %></span>
            <%= ACTION_LABELS[h.action] || h.action %>
            <span class="muted">· <%= h.user_name || '-' %> · <%= kst(h.created_at) %></span>
            <% if (h.result !== 'ok' || h.mode === 'local') { %><div class="muted small"><%= h.message %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <% } %>

  <section class="card">
    <h2>주문 정보</h2>
    <dl class="info">
      <dt>채널</dt><dd><%= channelInfo(order.channel).name %></dd>
      <dt>주문번호</dt><dd><%= order.channel_order_id %></dd>
      <% if (order.channel === 'manual') { %>
        <dt>주문 출처</dt><dd><%= sourceName || '출처 미지정' %></dd>
        <% if (order.source_order_no) { %><dt>판매처 주문번호</dt><dd><%= order.source_order_no %></dd><% } %>
      <% } %>
      <dt><%= order.channel === 'manual' ? '등록일' : '결제일' %></dt><dd><%= kst(order.paid_at) %></dd>
    </dl>
    <h2>상품별 상태</h2>
    <dl class="info">
      <% items.forEach(i => { %>
        <dt><%= i.item_type === 'addon' ? '추가상품' : '상품' %></dt>
        <dd>
          <%= i.product_name %>
          <div class="muted">상품주문번호 <%= i.channel_item_id %> · <%= i.channel_status_label ? `${channelInfo(i.channel).name} 상태: ${i.channel_status_label}` : channelStatusLabel(i.channel_status, i.channel) %><%= i.channel === 'manual' ? '' : i.channel_confirmed ? ' · 발주확인됨' : ' · 발주확인 전' %><%= i.claim_status ? ` · ${claimLabel(i.claim_status)}` : '' %></div>
          <% const ship = i.channel_status === 'PAYED' ? shipDueInfo(i.ship_due) : { text: '' }; %>
          <% if (i.delivery_type === 'TODAY' || i.delivery_type === 'OPTION_TODAY' || ship.text) { %>
            <div class="ship-line">
              <% if (i.delivery_type === 'TODAY' || i.delivery_type === 'OPTION_TODAY') { %><span class="today-badge">오늘출발</span><% } %>
              <% if (ship.text) { %><span class="pill <%= ship.cls %>"><%= ship.text %></span><% } %>
            </div>
          <% } %>
        </dd>
      <% }) %>
    </dl>
    <h2>배송지</h2>
    <dl class="info">
      <dt>주문자</dt><dd><%= order.buyer_name || '-' %><% if (order.buyer_phone) { %> · <a href="tel:<%= order.buyer_phone %>"><%= order.buyer_phone %></a><% } %></dd>
      <dt>받는 분</dt><dd><%= order.receiver_name || '-' %></dd>
      <dt>연락처</dt><dd><% if (order.receiver_phone) { %><a href="tel:<%= order.receiver_phone %>"><%= order.receiver_phone %></a><% } else { %>-<% } %></dd>
      <dt>주소</dt><dd><%= order.receiver_address || '-' %></dd>
    </dl>
    <% if (order.channel !== 'manual') { %><p class="muted">주문 정보와 배송지는 <%= channelInfo(order.channel).name %>에서 가져온 값이라 여기서 바꿀 수 없습니다.</p><% } %>
  </section>
  </div>
</div>
<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<%- include('../partials/footer') %>
