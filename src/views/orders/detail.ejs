<%- include('../partials/header') %>
<%
  const c = channelInfo(order.channel);
  const isManual = order.channel === 'manual';
  const stt = order.channel_status;
  const canceled = stt === 'CANCELED';
  const allConfirmed = items.every(i => i.channel_confirmed);
  const designName = (designStages.find(s => s.id === currentDesignId) || {}).name || '-';
  const ls = logen && logen.ship && logen.ship.status === 'registered' ? logen.ship : null;
  const isToday = items.some(i => i.channel_status === 'PAYED' && (i.delivery_type === 'TODAY' || i.delivery_type === 'OPTION_TODAY'));
  const shipDueText = (() => { const d = items.filter(i => i.channel_status === 'PAYED' && i.ship_due && !i.ship_delayed).map(i => i.ship_due).sort()[0]; return d ? shipDueInfo(d).text : ''; })();
  const short = t => kst(t).slice(5, 16);
  // 진행 단계 띠: 결제(등록) → 발주확인(입금) → 디자인·제작 → 로젠 송장 → 발송. 끝난 칸은 ✓, 지금 칸은 파란 밑줄
  const steps = [
    { k: isManual ? '등록' : '결제', v: short(order.paid_at), done: true },
    isManual
      ? { k: '입금', v: stt === 'PAYMENT_WAITING' ? '대기' : canceled ? '-' : '완료', done: stt !== 'PAYMENT_WAITING' && !canceled }
      : { k: '발주확인', v: allConfirmed ? '완료' : canConfirm ? '대기' : '-', done: allConfirmed },
    { k: '디자인·제작', v: designName, done: Boolean(shipped) },
    ...(logen ? [{ k: '로젠 송장', v: logen.slip || (ls ? '출력 대기' : logen.canRegister ? '등록 대기' : '-'), done: Boolean(logen.slip) }] : []),
    { k: '발송', v: shipped ? short(shipped.shipped_at) : canceled ? '취소' : shipDueText || '대기', done: Boolean(shipped) },
  ];
  const nowIdx = canceled ? -1 : steps.findIndex(s => !s.done);
  // 작업 파일 이름용 요약: 채널_날짜_구매자(받는 분). 받는 분이 같으면 괄호는 뺀다. 파일 이름에 못 쓰는 글자는 지운다
  const clean = t => String(t || '').replace(/[\\/:*?"<>|_\r\n]+/g, ' ').replace(/\s+/g, ' ').trim();
  const buyer = clean(order.buyer_name || order.receiver_name) || '이름없음';
  const receiver = clean(order.receiver_name);
  const fileLabel = [clean(isManual && sourceName ? sourceName : c.name), kst(order.paid_at).slice(0, 10).replace(/-/g, ''),
    `${buyer}${receiver && receiver !== buyer ? `(${receiver})` : ''}`].join('_');
%>
<% if (!locals.embed) { %>
  <p class="back-row"><a href="<%= back %>" class="btn-back">← 목록으로</a></p>
<% } %>

<%# 머리: 채널·주문번호·결제일 + 상품 이름 + 발주서 출력 %>
<div class="detail-head">
  <div class="detail-head-main">
    <p class="detail-channel">
      <span class="ch ch-<%= c.cls %>"><%= c.mark %></span><%= c.name %><% if (isManual && sourceName) { %> · <%= sourceName %><% } %> · 주문번호 <%= order.channel_order_id %> · <%= kst(order.paid_at) %> <%= isManual ? '등록' : '결제' %>
      <% if (isToday) { %><span class="today-badge" title="스마트스토어 오늘출발 상품">오늘출발</span><% } %>
      <% if (canceled) { %><span class="st-badge sb-cancel">취소</span><% } %>
    </p>
    <h1 class="detail-title"><%= items[0].product_name %><% if (items.length > 1) { %> <span class="muted">외 <%= items.length - 1 %>개</span><% } %></h1>
    <%# 작업 파일 이름 만들 때 그대로 붙여 넣는 한 줄 %>
    <p class="file-label"><code title="작업 파일 이름용"><%= fileLabel %></code><button type="button" class="btn-sm" data-copy="<%= fileLabel %>">📋 복사</button></p>
  </div>
  <div class="page-actions">
    <a class="btn-sm" href="/orders/<%= order.id %>/print" target="_blank" rel="noopener">🖨 발주서 출력</a>
  </div>
</div>

<ol class="progress" aria-label="진행 단계">
  <% steps.forEach((s, i) => { %>
    <li class="<%= s.done ? 'done' : '' %> <%= i === nowIdx ? 'now' : '' %>"><span class="pk"><%= i + 1 %>. <%= s.k %></span><strong class="pv"><%= s.v %></strong></li>
  <% }) %>
</ol>

<div class="detail" data-order-id="<%= order.id %>">
  <div class="detail-main">
  <% claimItems.forEach(i => { const level = claimLevel(i.claim_status); if (!level) return; %>
    <p class="claim-box <%= level === 'done' ? 'done' : '' %>">
      <strong><%= claimLabel(i.claim_status) %></strong>
      <%= i.product_name %><%= level === 'open' ? ` — ${order.channel === 'godo' ? '자사몰 관리자' : order.channel === 'coupang' ? '쿠팡 WING' : '판매자센터'}에서 먼저 처리하세요. 처리 전에는 발주확인·발송처리를 막아 둡니다.` : '' %>
    </p>
  <% }) %>

  <section class="card">
    <h2>상품 <span class="h2-sub"><%= items.length %>개</span></h2>
    <ul class="item-list">
      <% items.forEach(i => { %>
        <li class="<%= i.item_type === 'addon' ? 'addon' : '' %>">
          <div class="item-main">
            <%# 상품 이름을 누르면 손님이 보는 상품 페이지 (새 탭) %>
            <% const pUrl = productUrl(i); %>
            <div class="item-name"><% if (i.item_type === 'addon') { %><span class="tag">추가</span><% } %><% if (pUrl) { %><a href="<%= pUrl %>" target="_blank" rel="noopener noreferrer" class="product-link" title="<%= channelInfo(i.channel).name %> 상품 페이지 열기"><%= i.product_name %> <span aria-hidden="true">↗</span></a><% } else { %><%= i.product_name %><% } %></div>
            <% if (i.option_text) { %><div class="muted"><%= i.option_text %></div><% } %>
            <div class="muted small item-status">
              <%= isManual ? '' : `상품주문번호 ${i.channel_item_id} · ` %><%= i.channel_status_label ? `${channelInfo(i.channel).name} 상태: ${i.channel_status_label}` : channelStatusLabel(i.channel_status, i.channel) %><%= i.channel === 'manual' ? '' : i.channel_confirmed ? ' · 발주확인됨' : ' · 발주확인 전' %><%= i.claim_status ? ` · ${claimLabel(i.claim_status)}` : '' %>
            </div>
            <% const delayed = i.channel_status === 'PAYED' && i.ship_delayed ? delayInfo(i.ship_delayed, i.ship_due) : null; %>
            <% const ship = i.channel_status === 'PAYED' && !delayed ? shipDueInfo(i.ship_due) : { text: '' }; %>
            <% if (i.delivery_type === 'TODAY' || i.delivery_type === 'OPTION_TODAY' || ship.text || delayed) { %>
              <div class="ship-line">
                <% if (i.delivery_type === 'TODAY' || i.delivery_type === 'OPTION_TODAY') { %><span class="today-badge">오늘출발</span><% } %>
                <% if (ship.text) { %><span class="pill <%= ship.cls %>"><%= ship.text %></span><% } %>
                <% if (delayed) { %><span class="pill <%= delayed.cls %>" title="<%= delayed.title %>"><%= delayed.text %></span><% } %>
              </div>
            <% } %>
          </div>
          <div class="item-qty"><%= i.quantity %><small>개</small></div>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="card">
    <h2>배송지 · 주문 정보</h2>
    <dl class="info">
      <dt>주문자</dt><dd><%= order.buyer_name || '-' %><% if (order.buyer_phone) { %> · <%= order.buyer_phone %><% } %></dd>
      <dt>받는 분</dt><dd><%= order.receiver_name || '-' %></dd>
      <dt>연락처</dt><dd><%= order.receiver_phone || '-' %></dd>
      <dt>주소</dt><dd><%= order.receiver_address || '-' %></dd>
      <dt>배송 메시지</dt><dd><% if (order.ship_memo) { %><span class="ship-memo">💬 <%= order.ship_memo %></span><% } else { %><span class="muted">없음</span><% } %></dd>
      <dt>채널</dt><dd><%= c.name %></dd>
      <dt>주문번호</dt><dd><%= order.channel_order_id %></dd>
      <% if (isManual) { %>
        <dt>주문 출처</dt><dd><%= sourceName || '출처 미지정' %></dd>
        <% if (order.source_order_no) { %><dt>판매처 주문번호</dt><dd><%= order.source_order_no %></dd><% } %>
      <% } %>
      <dt><%= isManual ? '등록일' : '결제일' %></dt><dd><%= kst(order.paid_at) %></dd>
    </dl>
    <% if (!isManual) { %><p class="muted small">주문 정보와 배송지는 <%= c.name %>에서 가져온 값이라 여기서 바꿀 수 없습니다.</p><% } %>
  </section>

  <section class="card">
    <h2>작업 <span class="h2-sub"><%= items.length > 1 ? `상품 ${items.length}개에 함께 저장돼요` : '저장하면 담당자에게 알림이 가요' %></span></h2>
    <form method="post" action="/orders/<%= order.id %>" class="detail-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="version" value="<%= order.version %>">
      <input type="hidden" name="back" value="<%= back %>">

      <div class="two-fields">
        <label>디자인 단계
          <% if (canPickStage) { %>
            <select name="design_stage_id">
              <% designStages.forEach(s => { if (!s.active && s.id !== currentDesignId) return; %>
                <option value="<%= s.id %>" <%= s.id === currentDesignId ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          <% } else { %>
            <span class="readonly-value"><%= designName %> <span class="muted small">(디자이너만 변경)</span></span>
          <% } %>
        </label>
        <label>담당 디자이너
          <select name="assignee_id" class="<%= staffColor(order.assignee_id) %>">
            <option value="">미지정</option>
            <% if (order.assignee_id && !designers.some(d => d.id === order.assignee_id)) { %>
              <option value="<%= order.assignee_id %>" selected><%= order.assignee_name %> (디자이너 아님)</option>
            <% } %>
            <% designers.forEach(d => { %>
              <option value="<%= d.id %>" <%= d.id === order.assignee_id ? 'selected' : '' %>><%= d.name %><%= d.id === user.id ? ' (나)' : '' %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <div class="two-fields">
        <label>납기
          <input type="date" name="due_date" value="<%= order.due_date || '' %>">
        </label>
        <label>주문 단계 <span class="muted small">(자동)</span>
          <% if (user.role === 'admin') { %>
            <select name="stage_id">
              <% stages.forEach(s => { if (!s.active && s.id !== order.stage_id) return; %>
                <option value="<%= s.id %>" <%= s.id === order.stage_id ? 'selected' : '' %>><%= s.name %><%= s.active ? '' : ' (숨김)' %></option>
              <% }) %>
            </select>
          <% } else { %>
            <span class="readonly-value"><%= order.stage_name || '단계 없음' %></span>
          <% } %>
        </label>
      </div>

      <label>파일 위치 (NAS 경로)
        <input type="text" name="nas_path" value="<%= order.nas_path || '' %>" maxlength="300" placeholder="예: \\NAS\작업\2026\10\홍길동_명함">
      </label>

      <label>메모
        <textarea name="memo" rows="4" maxlength="2000" placeholder="작업 요청사항, 고객과 통화 내용 등"><%= order.memo || '' %></textarea>
      </label>

      <div class="form-actions end">
        <% if (isDesigner && order.assignee_id !== user.id) { %>
          <button type="submit" name="assignee_id" value="me" class="secondary">내가 맡기</button>
        <% } %>
        <button type="submit">저장</button>
      </div>
    </form>
  </section>
  </div>

  <div class="detail-side">
  <% if (['smartstore', 'coupang', 'godo'].includes(order.channel)) {
       const isCoupang = order.channel === 'coupang';
       // 쿠팡·자사몰의 발주확인 = 상품준비중 처리
       const isPrep = isCoupang || order.channel === 'godo'; %>
  <section class="card process-card">
    <h2><%= c.name %> 처리</h2>
    <% if (order.channel === 'godo') { %>
      <p class="muted small">자사몰 관리자에서 처리한 것과 똑같이 고객에게 알림톡·SMS 가 나갑니다. 자사몰 관리자에서 직접 처리해도 5분 안에 여기 상태가 바뀝니다.</p>
    <% } %>
    <% if (actionModes[order.channel] !== 'live') { %>
      <p class="practice-note"><strong>연습 모드</strong> 버튼을 눌러도 <%= WRITE_CHANNEL_NAMES[order.channel] %> 보내지 않고 기록만 남깁니다.</p>
    <% } %>

    <% if (canConfirm) { %>
      <form method="post" action="/orders/<%= order.id %>/confirm" data-once
            data-confirm="'<%= items[0].product_name %>' 주문을 <%= c.name %>에 <%= isPrep ? '상품준비중(발주확인)으로' : '발주확인' %> 처리할까요?&#10;고객에게 알림이 가고, 되돌릴 수 없습니다.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="wide"><%= isPrep ? '발주확인 (상품준비중) 보내기' : '발주확인 보내기' %></button>
      </form>
    <% } %>

    <% if (canDispatch) { %>
      <form method="post" action="/orders/<%= order.id %>/dispatch" class="dispatch-form" data-once
            data-confirm="{ship} 로 발송처리할까요?&#10;고객에게 발송 알림이 가고, 되돌리기 어렵습니다.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <%- include('../partials/ship-pick', { onlyDelivery: isCoupang, tracking: logen && logen.ship && logen.ship.slip_no && !shipped ? logen.ship.slip_no : '' }) %>
        <button type="submit" class="wide">발송처리 보내기</button>
      </form>
    <% } else if (canConfirm) { %>
      <p class="muted">발주확인을 하면 송장 입력 칸이 나타납니다.</p>
    <% } else if (!shipped) { %>
      <p class="muted">지금은 처리할 수 있는 상품이 없습니다 (결제완료가 아니거나 취소·반품 요청 중).</p>
    <% } %>

    <% if (delayed && !shipped) { const d = delayInfo(delayed.ship_delayed, delayed.ship_due); %>
      <p class="delay-line"><span class="pill <%= d.cls %>"><%= d.text %></span> <span class="muted small">사유: <%= DELAY_REASONS[delayed.ship_delayed] || delayed.ship_delayed %></span></p>
    <% } %>

    <% if (canDelay) { %>
      <%# 발송지연 처리: 네이버에 새 발송기한을 알리고 고객에게 안내가 간다. 주문마다 한 번만 %>
      <details class="delay-box">
        <summary>발송지연 처리</summary>
        <form method="post" action="/orders/<%= order.id %>/delay" data-once
              data-confirm="네이버에 발송지연 처리할까요?&#10;고객에게 지연 사유와 새 발송기한이 안내되고, 이 주문은 다시 지연 처리할 수 없습니다.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= back %>">
          <label>새 발송기한
            <input type="date" name="date" value="<%= delayDefault %>" min="<%= delayMin %>" required>
          </label>
          <label>사유
            <select name="reason">
              <% Object.entries(DELAY_REASONS).forEach(([code, label]) => { %>
                <option value="<%= code %>"><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label>상세 사유 <span class="muted small">(고객에게 보여요)</span>
            <textarea name="detail" rows="3" maxlength="300" required><%= DELAY_DEFAULT_TEXT %></textarea>
          </label>
          <p class="muted small">주문마다 한 번만 할 수 있어요. 새 발송기한까지 꼭 발송해 주세요.</p>
          <button type="submit" class="wide secondary">발송지연 보내기</button>
        </form>
      </details>
    <% } %>

    <% if (shipped) { %>
      <p class="shipped-line">
        <span class="st-badge sb-done">발송 완료</span>
        <%= shipMethodLabel(shipped.ship_method) %><% if (shipped.ship_company) { %> · <%= courierLabel(shipped.ship_company) %> <%= shipped.tracking_no %><% } %>
        <span class="muted">(<%= kst(shipped.shipped_at) %>)</span>
      </p>
    <% } %>

    <% if (history.length) { %>
      <h3>처리 기록</h3>
      <ul class="history">
        <% history.forEach(h => { %>
          <li>
            <span class="result r-<%= h.result %>"><%= RESULT_LABELS[h.result] %></span>
            <%= ACTION_LABELS[h.action] || h.action %>
            <span class="muted">· <%= h.user_name || '-' %> · <%= kst(h.created_at) %></span>
            <% if (h.result !== 'ok' || h.mode === 'local') { %><div class="muted small"><%= h.message %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <% } else if (isManual) { %>
  <% const st = stt; const editUrl = `/orders/${order.id}/manual-edit${back !== '/' ? `?back=${encodeURIComponent(back)}` : ''}`; %>
  <section class="card process-card">
    <h2>수기 주문</h2>
    <% if (st === 'CANCELED') { %><p class="claim-box"><strong>취소된 주문</strong></p><% } %>
    <dl class="info manual-pay">
      <dt>결제 방법</dt><dd><%= PAY_METHODS[order.pay_method] || '-' %></dd>
      <dt>금액</dt><dd><%= order.amount != null ? `${Number(order.amount).toLocaleString('ko-KR')}원` : '-' %></dd>
      <dt>입금자명</dt><dd><%= order.depositor || order.buyer_name || '-' %></dd>
    </dl>

    <% if (st === 'PAYMENT_WAITING') { %>
      <form method="post" action="/orders/<%= order.id %>/manual/paid" data-once
            data-confirm="<%= order.depositor || order.buyer_name %> 님 입금을 확인했나요?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="wide">입금 확인</button>
      </form>
    <% } %>

    <% if (st === 'PAYED' || st === 'PAYMENT_WAITING') { %>
      <form method="post" action="/orders/<%= order.id %>/manual/dispatch" class="dispatch-form" data-once
            data-confirm="{ship} 로 발송 완료 기록할까요?<%= st === 'PAYMENT_WAITING' ? '&#10;※ 아직 입금대기 상태입니다.' : '' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <%- include('../partials/ship-pick', { tracking: logen && logen.ship && logen.ship.slip_no && !shipped ? logen.ship.slip_no : '' }) %>
        <button type="submit" class="wide secondary">발송 완료 기록</button>
      </form>
      <p class="muted small">수기 주문은 인트라넷에만 기록됩니다. 고객 안내(문자 등)는 따로 해 주세요.</p>
    <% } %>

    <% if (shipped) { %>
      <p class="shipped-line">
        <span class="st-badge sb-done">발송 완료</span>
        <%= shipMethodLabel(shipped.ship_method) %><% if (shipped.ship_company) { %> · <%= courierLabel(shipped.ship_company) %> <%= shipped.tracking_no %><% } %>
        <span class="muted">(<%= kst(shipped.shipped_at) %>)</span>
      </p>
    <% } %>

    <div class="form-actions manual-actions">
      <a class="btn-sm" href="<%= editUrl %>">주문 정보 수정</a>
      <% if (st !== 'CANCELED') { %>
        <form method="post" action="/orders/<%= order.id %>/manual/cancel" class="inline" data-once
              data-confirm="이 수기 주문을 취소할까요?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= back %>">
          <button type="submit" class="btn-sm danger">주문 취소</button>
        </form>
      <% } %>
      <%# 잘못 넣었거나 필요 없는 수기 주문은 통째로 지운다 (되돌릴 수 없음) %>
      <form method="post" action="/orders/<%= order.id %>/manual/delete" class="inline" data-once
            data-confirm="이 수기 주문(<%= order.channel_order_id %>)을 지울까요?&#10;상품·메모·처리 기록까지 모두 지워지고 되돌릴 수 없습니다.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="btn-sm danger">주문 삭제</button>
      </form>
    </div>

    <% if (history.length) { %>
      <h3>처리 기록</h3>
      <ul class="history">
        <% history.forEach(h => { %>
          <li>
            <span class="result r-<%= h.result %>"><%= RESULT_LABELS[h.result] %></span>
            <%= ACTION_LABELS[h.action] || h.action %>
            <span class="muted">· <%= h.user_name || '-' %> · <%= kst(h.created_at) %></span>
            <% if (h.result !== 'ok' || h.mode === 'local') { %><div class="muted small"><%= h.message %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <% } %>
  <% if (logen) { %><%- include('../partials/logen-card', { logen, order, back }) %><% } %>
  <%- include('../partials/customer-history', { cust: customer }) %>
  </div>
</div>
<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<%- include('../partials/footer') %>
