<%- include('../partials/header') %>
<p class="muted"><a href="/">← 현황판</a></p>
<div class="page-head">
  <h1 class="page-title">
    <% if (order.urgent) { %><span class="ob-urgent">급</span><% } %><%= order.product_name %>
    <% if (order.done_at) { %><span class="status status-active">완료</span><% } else { %><span class="status"><%= order.stage_active ? order.stage_name : '단계 없음' %></span><% } %>
  </h1>
</div>

<section class="card">
  <% if (order.canceled) { %><p class="error">채널에서 <strong><%= channelStatusLabel(order.channel_status) %></strong>된 주문입니다. 작업하지 마세요.</p><% } %>
  <% if (order.done_at) { %>
    <p class="notice">완료한 주문입니다 (<%= kst(order.done_at) %>).</p>
    <form method="post" action="/orders/<%= order.id %>/reopen">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-sm">다시 열기</button>
    </form>
  <% } else { %>
    <div class="ob-stages" role="group" aria-label="작업 단계">
      <% stages.forEach(s => { %>
        <form method="post" action="/orders/<%= order.id %>/stage" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="stage_id" value="<%= s.id %>">
          <button type="submit" class="btn-sm<%= s.id === order.stage_id ? ' current' : '' %>" <%= s.id === order.stage_id ? 'disabled aria-current="step"' : '' %>><%= s.name %></button>
        </form>
      <% }) %>
    </div>
    <div class="ob-next">
      <% if (next) { %>
        <form method="post" action="/orders/<%= order.id %>/stage">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="stage_id" value="<%= next.id %>">
          <button type="submit">다음 단계: <%= next.name %> →</button>
        </form>
      <% } else { %>
        <form method="post" action="/orders/<%= order.id %>/done" data-confirm="완료 처리할까요? 현황판에서 빠집니다.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="approve">✔ 완료 처리</button>
        </form>
      <% } %>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>주문 정보</h2>
  <dl class="ob-info">
    <dt>접수</dt><dd><span class="ob-ch ob-ch-<%= order.channel %>"><%= order.channelLabel %></span>
      <% if (!order.manual) { %>주문번호 <%= order.channel_order_id %> · <%= channelStatusLabel(order.channel_status) %><% } %>
      · <%= kst(order.paid_at || order.created_at) %></dd>
    <% if (!order.manual) { %>
      <dt>상품</dt><dd><%= order.product_name %><% if (order.option_text) { %><div class="muted"><%= order.option_text %></div><% } %></dd>
      <dt>수량</dt><dd><%= order.quantity %></dd>
    <% } %>
    <dt>고객</dt><dd><%= order.buyer_name || '-' %><% if (order.receiver_name && order.receiver_name !== order.buyer_name) { %> (받는 분 <%= order.receiver_name %>)<% } %></dd>
    <dt>전화</dt><dd><% if (order.receiver_phone) { %><a href="tel:<%= order.receiver_phone.replace(/[^0-9]/g, '') %>"><%= order.receiver_phone %></a><% } else { %>-<% } %></dd>
    <% if (order.receiver_address) { %><dt>주소</dt><dd><%= order.receiver_address %></dd><% } %>
  </dl>
  <% if (locals.proofsEnabled && !order.done_at) { %>
    <p><a class="btn-sm" href="/proofs/new?order=<%= order.id %>">시안 보내기</a></p>
  <% } %>
</section>

<section class="card">
  <h2>작업</h2>
  <form method="post" action="/orders/<%= order.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (order.manual) { %><%- include('_customer', { o: order }) %><% } %>
    <%- include('_fields', { o: order }) %>
    <button type="submit">저장</button>
  </form>
</section>

<section class="card">
  <h2>기록</h2>
  <% if (!events.length) { %>
    <p class="muted">아직 기록이 없습니다.</p>
  <% } else { %>
    <ul class="ob-events">
      <% events.forEach(e => { %>
        <li><span class="muted"><%= kst(e.created_at).slice(5) %> · <%= e.user_name || '자동' %></span> <%= e.message %></li>
      <% }) %>
    </ul>
  <% } %>
</section>
<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
