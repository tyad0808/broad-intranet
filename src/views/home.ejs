<%- include('partials/header') %>
<section class="card">
  <h1>안녕하세요, <%= user.name %> 님</h1>
  <p>로그인되었습니다.<% if (user.job_name) { %> 직무: <%= user.job_name %><% } %></p>
  <% if (user.role === 'admin') { %>
    <p><a href="/admin/users">관리자 메뉴</a>에서 직원 승인, 작업 단계, 직무를 관리할 수 있습니다.<% if (pendingCount > 0) { %> 승인을 기다리는 가입 신청이 <strong><%= pendingCount %>건</strong> 있습니다.<% } %></p>
  <% } %>
  <p class="muted">주문 목록은 5단계에서 이 자리에 생깁니다.</p>
</section>
<%- include('partials/footer') %>
