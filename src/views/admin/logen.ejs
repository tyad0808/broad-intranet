<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<% if (!logen || !logen.hasKey) { %>
  <section class="card">
    <h2>로젠 연결</h2>
    <p class="error">로젠 인증키가 없습니다. 서버 <code>.env</code> 의 <code>LOGEN_SECRET_KEY</code>·<code>LOGEN_CUST_CD</code> 를 채우고 다시 시작해 주세요.</p>
  </section>
<% } else { const c = logen.contract; %>
  <section class="card">
    <h2>로젠 연결</h2>
    <dl class="info">
      <dt>보내는 곳</dt>
      <dd><% if (logen.env === 'prod') { %><strong>실제 서버</strong> (우리 거래처코드)<% } else { %><strong>테스트 서버</strong> · 우리 거래처코드로 보내지만 실제 택배는 생기지 않아요. 고객 정보 대신 연습용 정보를 보내요.<% } %></dd>
      <dt>실제 등록</dt>
      <dd><% if (logen.env !== 'prod') { %><span class="muted">테스트 서버라 상관없음</span><% } else if (logen.writeOn) { %><strong>켜짐</strong> · 등록하면 iLOGEN 에 바로 들어가요<% } else { %><strong class="text-bad">꺼짐</strong> · <code>.env</code> 의 <code>LOGEN_WRITE=on</code> 이어야 등록돼요<% } %></dd>
      <dt>송장번호 대기</dt>
      <dd><%= logen.waiting %>건 <span class="muted small">(등록했지만 아직 송장번호를 못 받은 주문 · 5분마다 알아서 확인해요)</span></dd>
      <% if (logen.lastTick) { %><dt>마지막 확인</dt><dd class="muted"><%= kst(logen.lastTick.at) %> · 송장번호 <%= logen.lastTick.found %>건 받음</dd><% } %>
    </dl>
    <p class="muted small">로젠 요청대로 한 번에 10건씩, 차례대로, 호출 사이에 3초씩 쉬면서 보내요. 그래서 많이 고르면 몇 초 걸릴 수 있어요.</p>
  </section>

  <section class="card">
    <h2>① 계약 정보</h2>
    <% if (c) { %>
      <dl class="info">
        <dt>영업소</dt><dd><%= c.salesNm %> <span class="muted">· 지점 <%= c.branNm %></span></dd>
        <dt>운임</dt><dd><%= c.fareTyNm %> (<%= c.fareTy %>)<% if (c.useYn === 'N') { %> <strong class="text-bad">사용 안 함</strong><% } else if (c.useYn && c.useYn !== 'Y') { %> <span class="muted small">(사용 상태 <%= c.useYn %>)</span><% } %></dd>
        <dt>박스</dt><dd><%= c.boxes.map(b => `${b.nm} ${b.fare.toLocaleString('ko-KR')}원`).join(' · ') || '-' %></dd>
        <dt>불러온 때</dt><dd class="muted"><%= kst(c.at) %></dd>
      </dl>
    <% } else { %>
      <p class="muted">아직 불러오지 않았어요. 아래 버튼을 눌러 로젠에서 계약 정보와 운임을 받아 오세요.</p>
    <% } %>
    <form method="post" action="/admin/logen/contract" data-once>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-sm"><%= c ? '다시 불러오기' : '계약 정보 불러오기' %></button>
    </form>
  </section>

  <section class="card">
    <h2>② 보내는 분 · 기본 박스</h2>
    <form method="post" action="/admin/logen/settings" class="settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>보내는 분 이름 (송장에 찍혀요)
        <input type="text" name="name" value="<%= logen.sender.name %>" maxlength="50" required>
      </label>
      <label>보내는 분 주소
        <input type="text" name="addr" value="<%= logen.sender.addr %>" maxlength="300" required placeholder="경기 양주시 …">
      </label>
      <label>보내는 분 전화번호
        <input type="text" name="tel" value="<%= logen.sender.tel %>" inputmode="numeric" maxlength="20" required placeholder="숫자만">
      </label>
      <label>기본 박스
        <select name="box" <%= c && c.boxes.length ? '' : 'disabled' %>>
          <% (c ? c.boxes : []).forEach(b => { %>
            <option value="<%= b.cd %>" <%= logen.box && logen.box.cd === b.cd ? 'selected' : '' %>><%= b.nm %> · <%= b.fare.toLocaleString('ko-KR') %>원</option>
          <% }) %>
        </select>
        <% if (!c) { %><span class="muted small">① 계약 정보를 먼저 불러오면 고를 수 있어요.</span><% } %>
      </label>
      <%# 송장 운임: iLOGEN 에서 실제로 쓰는 금액이 계약 운임과 다르면 여기에 (예: 계약 2,500원 → 실제 2,650원). 비우면 계약 운임 %>
      <label>송장 운임 (원)
        <input type="text" name="fare" value="<%= logen.fareSet || '' %>" inputmode="numeric" maxlength="7" placeholder="<%= logen.box ? `비우면 계약 운임 ${logen.box.fare.toLocaleString('ko-KR')}원` : '비우면 계약 운임' %>">
        <span class="muted small">
          로젠에 등록할 때 이 금액으로 보내요.
          <% if (logen.fare != null) { %>지금: <strong><%= logen.fare.toLocaleString('ko-KR') %>원</strong><% if (logen.fareSet && logen.box) { %> (계약 운임 <%= logen.box.fare.toLocaleString('ko-KR') %>원)<% } else if (!logen.fareSet) { %> (계약 운임 그대로)<% } %><% } %>
          · 금액이 바뀌면 여기서 고치고 저장하면 다음 등록부터 적용돼요.
        </span>
      </label>
      <button type="submit" class="btn-sm">저장</button>
    </form>
  </section>

  <section class="card">
    <h2>③ 자동 발송처리</h2>
    <p>지금: <strong class="<%= logen.autoDispatch ? '' : 'muted' %>"><%= logen.autoDispatch ? '켜짐' : '꺼짐' %></strong></p>
    <p class="muted small">
      <% if (logen.autoDispatch) { %>송장번호가 들어오면 스마트스토어·쿠팡·자사몰에 바로 발송처리를 보내요. 고객에게 발송 알림이 가요. (수기 주문·발주확인 전 주문은 직원이 직접)
      <% } else { %>송장번호만 주문에 채워 두고, 발송처리는 담당자가 주문을 체크해서 눌러요. 시스템이 익숙해지면 켜 주세요.<% } %>
    </p>
    <form method="post" action="/admin/logen/auto-dispatch" data-once
          data-confirm="<%= logen.autoDispatch ? '자동 발송처리를 끌까요?' : '자동 발송처리를 켤까요?&#10;송장번호가 들어오면 사람 확인 없이 고객에게 발송 알림이 갑니다.' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="on" value="<%= logen.autoDispatch ? '0' : '1' %>">
      <button type="submit" class="btn-sm"><%= logen.autoDispatch ? '끄기' : '켜기' %></button>
    </form>
  </section>

  <section class="card">
    <h2>쓰는 방법</h2>
    <ol class="plain-steps">
      <li><strong>주문 목록</strong>에서 주문을 체크하고 아래 막대의 <strong>[로젠 등록]</strong>을 눌러요. 주문번호가 같은 상품은 한 송장(한 박스)으로 묶여요.</li>
      <li><strong>iLOGEN</strong>(logis.ilogen.com) › '주문등록출력(복수건)' › 엑셀타입 '전체' 로 조회해서 출력해요. 출력해야 송장번호가 생겨요. <a class="btn-sm" href="https://logis.ilogen.com" target="_blank" rel="noopener">iLOGEN 출력 화면 열기 ↗</a></li>
      <li>5분 안에 송장번호가 <strong>알아서</strong> 주문에 들어가요. 급하면 주문 목록 위 [송장번호 가져오기]를 눌러도 돼요.</li>
      <li>담당자가 주문을 체크하고 <strong>[송장 입력·발송처리]</strong>를 누르면 송장번호가 미리 채워져 있어요. 확인하고 보내면 끝이에요. (③ 자동 발송처리를 켜면 이 단계도 자동)</li>
    </ol>
    <% if (!logen.ready) { %><p class="warn-box">아직 정하지 않은 것: <%= logen.missing.join(', ') %></p><% } %>
  </section>
<% } %>
<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
