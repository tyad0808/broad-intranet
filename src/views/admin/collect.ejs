<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<section class="card">
  <h2>주문 수집</h2>
  <% if (!source) { %>
    <p class="notice">주문 수집이 <strong>꺼져</strong> 있습니다 (.env 의 ORDER_SOURCE=off).
      네이버 커머스 API 키를 .env 에 넣고 ORDER_SOURCE=naver 로 바꾼 뒤 서버를 다시 시작하면 수집이 시작됩니다.</p>
  <% } else { %>
    <p>
      출처: <strong><%= source.label %></strong>
      <% if (source.isMock) { %><span class="status status-pending">개발용</span><% } %>
      · <%= orderInterval %>분마다 자동 수집 · 저장된 주문 <strong><%= total %>건</strong>
    </p>
    <% if (source.isMock) { %>
      <p class="muted">지금은 가짜 주문으로 동작합니다. 서버에 올린 뒤 .env 의 ORDER_SOURCE 를 naver 로 바꾸면 실제 스마트스토어 주문을 가져옵니다.
        발주확인·발송처리는 .env 의 NAVER_WRITE=on 일 때만 네이버로 보냅니다.</p>
    <% } %>
    <form method="post" action="/admin/collect" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-sm primary">지금 수집</button>
    </form>
  <% } %>
</section>

<section class="card">
  <h2>자동 수집 간격</h2>
  <p class="muted">몇 분마다 새 주문과 메일을 가져올지 정합니다 (<%= MIN_MINUTES %>~<%= MAX_MINUTES %>분). 저장하면 다음 회차부터 바로 적용됩니다.
    너무 짧게 하면 쇼핑몰·메일 서버가 요청을 잠시 막을 수 있어 3~10분을 권합니다.</p>
  <form method="post" action="/admin/collect-interval" class="row-edit interval-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>주문 수집 <input type="number" name="order_interval_minutes" value="<%= orderInterval %>" min="<%= MIN_MINUTES %>" max="<%= MAX_MINUTES %>" required> 분마다</label>
    <label>메일 받기 <input type="number" name="inbox_interval_minutes" value="<%= inboxInterval %>" min="<%= MIN_MINUTES %>" max="<%= MAX_MINUTES %>" required> 분마다</label>
    <button type="submit" class="btn-sm primary">저장</button>
  </form>
</section>

<section class="card" id="file-label">
  <h2>작업 파일 이름 모양</h2>
  <p class="muted">주문 상세 창 제목 아래 <strong>[📋 복사]</strong> 한 줄의 모양이에요. 이름표 버튼을 누르면 커서 자리에 들어가고, 사이에는 <code>_</code> <code>-</code> 괄호 빈칸 같은 글자를 자유롭게 넣으면 돼요.
    값이 비면 빈 괄호와 겹친 구분자는 알아서 지워요.</p>
  <form method="post" action="/admin/file-label" class="file-label-form" data-file-label>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="file-pattern">모양</label>
    <input type="text" id="file-pattern" name="pattern" value="<%= filePattern %>" maxlength="100" required autocomplete="off" spellcheck="false">
    <div class="token-chips" aria-label="이름표 넣기">
      <% TOKENS.forEach(([name, help]) => { %><button type="button" class="btn-sm" data-token="{<%= name %>}" title="<%= help %>">{<%= name %>}</button><% }) %>
    </div>
    <p class="file-preview">미리 보기 <strong data-file-preview><%= filePreview %></strong> <span class="muted small" data-file-preview-note>(가장 최근 주문으로)</span></p>
    <div class="form-actions">
      <button type="submit" class="btn-sm primary">저장</button>
      <button type="submit" name="action" value="reset" class="btn-sm ghost" formnovalidate>처음 모양으로 (<%= DEFAULT_PATTERN %>)</button>
    </div>
  </form>
  <details class="token-help">
    <summary>이름표 설명</summary>
    <ul class="plain"><% TOKENS.forEach(([name, help]) => { %><li><code>{<%= name %>}</code> <%= help %></li><% }) %></ul>
  </details>
</section>
<script src="/admin-file-label.js"></script>

<section class="card">
  <h2>스마트스토어 주소</h2>
  <p class="muted">주문 상세에서 상품 이름을 누르면 손님이 보는 상품 페이지가 열려요. 스마트스토어는 우리 가게 주소가 있어야 정확히 열립니다. (쿠팡·자사몰은 따로 필요 없어요)</p>
  <form method="post" action="/admin/store-url" class="row-edit">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>가게 주소 <input type="text" name="smartstore_url" value="<%= smartstoreUrl %>" placeholder="https://smartstore.naver.com/가게주소" maxlength="120"></label>
    <button type="submit" class="btn-sm primary">저장</button>
  </form>
</section>

<section class="card">
  <h2>최근 수집 기록</h2>
  <% if (runs.length === 0) { %>
    <p class="muted">아직 수집 기록이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>시각</th><th>결과</th><th>새 주문</th><th>바뀐 주문</th><th>비고</th></tr></thead>
        <tbody>
          <% runs.forEach(r => { %>
            <tr>
              <td class="nowrap"><%= kst(r.started_at) %></td>
              <td>
                <% if (r.ok === 1) { %><span class="status status-active">성공</span>
                <% } else if (r.ok === 0) { %><span class="status status-suspended">실패</span>
                <% } else { %><span class="status">진행 중</span><% } %>
              </td>
              <td><%= r.created %></td>
              <td><%= r.updated %></td>
              <td class="muted"><%= r.error || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>최근 들어온 주문 <span class="muted">(확인용, 주문 목록 화면은 5단계)</span></h2>
  <% if (recent.length === 0) { %>
    <p class="muted">아직 주문이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>상품주문번호</th><th>상품</th><th>수량</th><th>채널 상태</th><th>발주확인</th><th>작업 단계</th></tr></thead>
        <tbody>
          <% recent.forEach(o => { %>
            <tr>
              <td class="muted nowrap"><%= o.channel_item_id %></td>
              <td class="product"><%= o.product_name %><% if (o.option_text) { %><div class="muted"><%= o.option_text %></div><% } %></td>
              <td><%= o.quantity %></td>
              <td><%= channelStatusLabel(o.channel_status) %></td>
              <td><%= o.channel_confirmed ? '완료' : '대기' %></td>
              <td><%= o.stage_name || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
