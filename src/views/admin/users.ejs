<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<%
  // 직원 이름 등 사용자가 입력한 글자를 HTML 로 해석되지 않게 바꾼다 (스크립트 주입 방지)
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // 버튼 하나짜리 폼 (CSRF 토큰 포함)
  const action = (url, label, cls = '', confirmMsg = '') => `
    <form method="post" action="${esc(url)}" class="inline"${confirmMsg ? ` data-confirm="${esc(confirmMsg)}"` : ''}>
      <input type="hidden" name="_csrf" value="${esc(csrfToken)}">
      <button type="submit" class="btn-sm ${cls}">${esc(label)}</button>
    </form>`;
%>

<section class="card">
  <h2>가입 신청 <span class="muted"><%= pending.length %>건</span></h2>
  <% if (pending.length === 0) { %>
    <p class="muted">새 가입 신청이 없습니다.</p>
  <% } else { %>
    <ul class="rows">
      <% pending.forEach(u => { %>
        <li class="row">
          <div class="row-main">
            <strong><%= u.name %></strong><% if (u.nickname) { %> <span class="nick-tag" title="시안확정서에 들어가는 별명">별명 <%= u.nickname %></span><% } %>
            <span class="muted"><%= u.email %> · <%= u.job_name || '직무 없음' %> · <%= kst(u.created_at) %> 신청</span>
          </div>
          <div class="row-actions">
            <%- action(`/admin/users/${u.id}/approve`, '승인', 'primary') %>
            <%- action(`/admin/users/${u.id}/reject`, '거절', 'danger', `${u.name} 님의 가입 신청을 거절할까요?`) %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="card">
  <h2>직원 목록 <span class="muted"><%= others.length %>명</span></h2>
  <p class="muted small"><strong>별명</strong>은 고객에게 보내는 시안확정서에 실명 대신 들어가요 (비워 두면 시안확정서 담당 칸이 비어요). 직원을 지우려면 먼저 <strong>정지</strong>한 뒤 <strong>삭제</strong>를 누르세요.</p>
  <p class="muted small">역할: <strong>직원</strong> 기본 기능 · <strong>부관리자</strong> 통계·주문 단계 바꾸기·남의 일정 고치기·답장 문구 엑셀까지 다 쓰고, 관리자 설정(이 관리자 메뉴)만 못 들어와요 · <strong>관리자</strong> 전부</p>
  <ul class="rows">
    <% others.forEach(u => { const isMe = u.id === user.id; const locked = u.locked_until && new Date(u.locked_until) > now; %>
      <li class="row">
        <div class="row-main">
          <strong><%= u.name %></strong><% if (isMe) { %> <span class="muted">(나)</span><% } %>
          <span class="status status-<%= u.status %>"><%= STATUS_LABELS[u.status] %></span>
          <% if (locked) { %><span class="status status-suspended">로그인 잠김</span><% } %>
          <div class="muted"><%= u.email %></div>
        </div>
        <form method="post" action="/admin/users/<%= u.id %>/update" class="row-edit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="nickname" value="<%= u.nickname || '' %>" maxlength="20" placeholder="별명" aria-label="<%= u.name %> 별명 (시안확정서용)" class="nick-input">
          <select name="job_id" aria-label="직무">
            <option value="">직무 없음</option>
            <% jobs.forEach(j => { %>
              <option value="<%= j.id %>" <%= u.job_id === j.id ? 'selected' : '' %>><%= j.name %><%= j.active ? '' : ' (숨김)' %></option>
            <% }) %>
          </select>
          <%# 역할: 직원 · 부관리자(관리자 설정만 빼고 다 씀) · 관리자 %>
          <% const roleKey = u.role === 'admin' ? 'admin' : u.sub_admin ? 'sub' : 'staff'; %>
          <select name="role" aria-label="역할" <%= isMe ? 'disabled' : '' %>>
            <option value="staff" <%= roleKey === 'staff' ? 'selected' : '' %>>직원</option>
            <option value="sub" <%= roleKey === 'sub' ? 'selected' : '' %>>부관리자</option>
            <option value="admin" <%= roleKey === 'admin' ? 'selected' : '' %>>관리자</option>
          </select>
          <% if (isMe) { %><input type="hidden" name="role" value="<%= roleKey %>"><% } %>
          <button type="submit" class="btn-sm">저장</button>
        </form>
        <div class="row-actions">
          <% if (locked) { %><%- action(`/admin/users/${u.id}/unlock`, '잠금 풀기') %><% } %>
          <% if (!isMe && u.status === 'active') { %>
            <%- action(`/admin/users/${u.id}/suspend`, '정지', 'danger', `${u.name} 님의 계정을 정지할까요? 즉시 로그아웃됩니다.`) %>
          <% } else if (!isMe && u.status === 'rejected') { %>
            <%- action(`/admin/users/${u.id}/delete`, '삭제', 'danger', `${u.name} 계정을 지울까요?`) %>
          <% } else if (!isMe && u.status === 'suspended') { %>
            <%- action(`/admin/users/${u.id}/reactivate`, '정지 해제', 'primary') %>
            <% const r = u.release || { orders: 0, asks: 0 }; const moved = [r.orders ? `진행 중 주문 ${r.orders}건` : '', r.asks ? `미답변 문의 ${r.asks}건` : ''].filter(Boolean).join('·'); %>
            <%- action(`/admin/users/${u.id}/delete`, '삭제', 'danger', `${u.name} 님을 삭제할까요?${moved ? `\n담당 중인 ${moved}은 미지정이 됩니다.` : ''}\n지난 처리 기록에는 이름이 그대로 남고, 되돌릴 수 없습니다.`) %>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>

<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
