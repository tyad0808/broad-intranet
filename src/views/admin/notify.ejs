<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<form method="post" action="/admin/notify">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card">
    <h2>미지정 초과 알림</h2>
    <p class="muted">담당 디자이너가 없는 진행 중 주문이 기준 건수를 <strong>넘으면</strong> 바로 한 번 알리고,
      해소될 때까지 정해진 간격마다 다시 알립니다. 지금 미지정 주문은 <strong><%= unassigned %>건</strong>입니다.</p>
    <div class="row-edit">
      <label class="inline-label">기준 건수
        <input type="number" name="threshold" value="<%= threshold %>" min="1" max="999" required>
      </label>
      <label class="inline-label">다시 알림 간격 (분)
        <input type="number" name="repeat_minutes" value="<%= repeatMinutes %>" min="5" max="240" required>
      </label>
    </div>

    <h2>받는 사람</h2>
    <p class="muted">관리자는 항상 받습니다. 함께 받을 직원을 고르세요.</p>
    <ul class="check-list">
      <% staff.forEach(s => { %>
        <li>
          <label class="check">
            <% if (s.role === 'admin') { %>
              <input type="checkbox" checked disabled> <%= s.name %> <span class="muted">관리자</span>
            <% } else { %>
              <input type="checkbox" name="recipients" value="<%= s.id %>" <%= recipients.includes(s.id) ? 'checked' : '' %>>
              <%= s.name %> <span class="muted"><%= s.job_name || '' %></span>
            <% } %>
          </label>
        </li>
      <% }) %>
    </ul>
    <button type="submit" class="btn-sm primary">저장</button>
  </section>
</form>

<section class="card" id="sounds">
  <h2>알림 소리</h2>
  <p class="muted">알림 종류마다 소리를 바꿀 수 있어요. <strong>MP3·WAV·OGG·M4A</strong>(휴대폰 녹음) 파일, 1MB 까지. 저장하면 모든 직원 화면에서 그 소리가 나요 (직원 화면은 새로고침하면 바로 바뀜).</p>
  <ul class="sound-list">
    <% soundList.forEach(s => { %>
      <li class="sound-row">
        <div class="sound-name">
          <strong><%= s.label %></strong>
          <span class="muted small"><%= s.mode === 'file' ? `올린 소리: ${s.name}` : s.mode === 'off' ? '소리 없음' : '기본 소리' %></span>
        </div>
        <div class="sound-actions">
          <% if (s.mode !== 'off') { %>
            <button type="button" class="btn-sm" data-play-sound="<%= s.kind %>" <% if (s.mode === 'file') { %>data-url="/sounds/<%= s.kind %>?v=<%= s.v %>"<% } %>>▶ 들어보기</button>
          <% } %>
          <form method="post" action="/admin/sounds" enctype="multipart/form-data" class="sound-upload" data-once>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="kind" value="<%= s.kind %>">
            <input type="hidden" name="action" value="upload">
            <input type="file" name="file" accept="audio/mpeg,audio/wav,audio/ogg,audio/mp4,audio/x-m4a,.mp3,.wav,.ogg,.m4a" required aria-label="<%= s.label %> 소리 파일" data-sound-file="<%= s.kind %>">
            <button type="button" class="btn-sm ghost" data-preview-file hidden>▶ 고른 파일</button>
            <button type="submit" class="btn-sm primary">올리기</button>
          </form>
          <% [['default', '기본으로', s.mode !== 'default'], ['off', '소리 없음', s.mode !== 'off']].forEach(([action, text, show]) => { if (!show) return; %>
            <form method="post" action="/admin/sounds" class="inline" data-once>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="kind" value="<%= s.kind %>">
              <input type="hidden" name="action" value="<%= action %>">
              <button type="submit" class="btn-sm ghost"><%= text %></button>
            </form>
          <% }) %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>
<script src="/admin-sound.js"></script>

<section class="card">
  <h2>다른 알림</h2>
  <ul class="plain">
    <li><strong>신규 발주</strong>: 새 주문이 수집되면 전 직원에게</li>
    <li><strong>가입 신청</strong>: 직원이 회원가입하면 관리자에게</li>
  </ul>
  <p class="muted">알림은 인트라넷 화면이 열려 있을 때 화면 알림 + 소리로 뜨고, 브라우저 알림을 허용하면 다른 창을 보고 있어도 뜹니다.</p>
</section>
<section class="card" id="weekly">
  <h2>주간 매출 보고 메일</h2>
  <p class="muted">정한 요일·시각에 이번 주(월요일 0시 ~ 보내는 시각)의 <strong>매출 · 객단가 · 발송된 택배 수</strong>를 지난주 같은 구간과 비교해서 보내요. 채널별 매출도 함께 들어가요.
    <br>월요일로 정하면 <strong>지난주 월~일 전체</strong>를 그 전 주와 비교해요.</p>
  <% if (!weekly.ready) { %>
    <p class="error">보낼 메일 계정이 없어요. 서버 .env 에 네이버메일(또는 지메일) 계정을 넣어야 보낼 수 있어요.</p>
  <% } else { %>
    <p class="muted small">보내는 메일: <%= weekly.sender %></p>
  <% } %>
  <form method="post" action="/admin/weekly-report" class="settings-form weekly-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>받는 사람 메일 주소 <span class="muted small">(여러 명은 쉼표로, 최대 10명)</span>
      <textarea name="recipients" rows="2" placeholder="예: boss@broadstore.co.kr, manager@naver.com"><%= weekly.recipients.join(', ') %></textarea>
    </label>
    <div class="two-fields">
      <label>보내는 요일
        <select name="day">
          <% [1, 2, 3, 4, 5, 6, 0].forEach(d => { %><option value="<%= d %>" <%= weekly.day === d ? 'selected' : '' %>><%= DAYS[d] %>요일</option><% }) %>
        </select>
      </label>
      <label>보내는 시각
        <select name="hour">
          <% for (let h = 0; h < 24; h++) { %><option value="<%= h %>" <%= weekly.hour === h ? 'selected' : '' %>><%= h < 12 ? `오전 ${h === 0 ? 12 : h}시` : `오후 ${h === 12 ? 12 : h - 12}시` %> (<%= String(h).padStart(2, '0') %>:00)</option><% } %>
        </select>
      </label>
    </div>
    <label>메일 제목 <span class="muted small">(비우면 기본 제목)</span>
      <input type="text" name="subject" maxlength="120" value="<%= weekly.subject %>" placeholder="<%= weekly.encrypt ? SAFE_SUBJECT : DEFAULT_SUBJECT %>">
    </label>
    <p class="muted small">자동으로 바뀌는 칸: <code class="var">{회사명}</code> <code class="var">{기간}</code> <code class="var">{매출}</code> <code class="var">{변화}</code> — 암호화를 켜면 {매출}·{변화}는 제목에서 빠져요.</p>

    <fieldset class="encrypt-box">
      <legend>암호화 (비밀번호 PDF)</legend>
      <label class="check"><input type="checkbox" name="encrypt" value="1" <%= weekly.encrypt ? 'checked' : '' %>> 메일 본문에는 숫자를 넣지 않고, 비밀번호가 걸린 PDF로 보내기</label>
      <div class="two-fields">
        <label>PDF 비밀번호 <span class="muted small"><%= weekly.hasPassword ? '(설정됨 · 바꿀 때만 적으세요)' : `(${MIN_PASSWORD}자 이상)` %></span>
          <input type="password" name="password" autocomplete="new-password" minlength="<%= MIN_PASSWORD %>" placeholder="<%= weekly.hasPassword ? '●●●●●● (그대로 두기)' : '' %>">
        </label>
        <label>비밀번호 한 번 더
          <input type="password" name="password2" autocomplete="new-password">
        </label>
      </div>
      <p class="muted small">비밀번호는 PDF를 잠글 때 써야 해서 서버에만 저장돼요. 한 번 저장하면 화면에 다시 보이지 않아요. 받는 분들께는 따로(전화·카톡) 알려 주세요.</p>
    </fieldset>

    <label class="check"><input type="checkbox" name="enabled" value="1" <%= weekly.enabled ? 'checked' : '' %>> 매주 정한 요일·시각에 보내기</label>
    <div class="form-actions">
      <button type="submit" class="btn-sm primary">저장</button>
    </div>
  </form>
  <form method="post" action="/admin/weekly-report/test" data-once class="weekly-test">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn-sm" <%= weekly.ready && weekly.recipients.length ? '' : 'disabled' %>>지금 테스트로 보내기</button>
    <span class="muted small">이번 주 월요일부터 지금까지 내용으로 한 통 보내요 (제목에 [테스트]<%= weekly.encrypt ? ', 비밀번호 PDF' : '' %>)</span>
  </form>
  <% if (weekly.last) { %>
    <p class="small <%= weekly.last.ok ? 'muted' : 'error' %>">마지막 발송: <%= kst(weekly.last.at) %><%= weekly.last.test ? ' (테스트)' : '' %> · <%= weekly.last.message %></p>
  <% } %>
</section>
<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
