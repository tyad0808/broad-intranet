<%- include('../partials/header') %>
<h1 class="page-title">관리자</h1>
<%- include('../partials/admin-tabs') %>

<section class="card">
  <h2>발주확인·발송처리 기록</h2>
  <p class="muted">
    지금: <strong><%= actionMode === 'live' ? '실제로 네이버에 보냄' : '연습 모드 (네이버로 보내지 않음)' %></strong>
    · 바꾸려면 서버 .env 의 NAVER_WRITE 를 고치고 재시작합니다.
  </p>
  <nav class="channel-chips">
    <% [['', '전체'], ['problem', '확인 필요·실패'], ['live', '실제 처리'], ['practice', '연습']].forEach(([key, label]) => { %>
      <a href="/admin/actions<%= key ? `?f=${key}` : '' %>" class="chip <%= filter === key ? 'on' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <% if (actions.length === 0) { %>
    <p class="muted">아직 기록이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>시각</th><th>직원</th><th>처리</th><th>주문</th><th>결과</th><th>내용</th></tr></thead>
        <tbody>
          <% actions.forEach(a => { const d = a.detailObj; %>
            <tr>
              <td class="nowrap"><%= kst(a.created_at) %></td>
              <td class="nowrap"><%= a.user_name || '-' %></td>
              <td class="nowrap">
                <%= a.action === 'confirm' ? '발주확인' : '발송처리' %>
                <% if (d && d.method) { %><div class="muted"><%= d.company ? `${courierLabel(d.company)} ${d.tracking}` : shipMethodLabel(d.method) %></div><% } %>
              </td>
              <td class="product">
                <% if (a.order_id) { %><a href="/orders/<%= a.order_id %>"><%= a.product_name %></a><% } else { %><%= a.channel_order_id %><% } %>
                <div class="muted"><%= a.channel_order_id %> · 상품 <%= JSON.parse(a.item_ids).length %>개</div>
              </td>
              <td class="nowrap">
                <span class="result r-<%= a.result %>"><%= { ok: '완료', partial: '일부', fail: '실패', unknown: '확인 필요', practice: '연습' }[a.result] %></span>
              </td>
              <td class="muted"><%= a.message || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
