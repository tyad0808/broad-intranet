<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<section class="card">
  <h2>서버 디스크</h2>
  <% if (info.disk) { %>
    <div class="meter <%= info.alert ? 'alert' : '' %>" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= info.disk.percent %>" aria-label="디스크 사용량">
      <span style="width: <%= Math.min(100, info.disk.percent) %>%"></span>
    </div>
    <p><strong><%= info.disk.percent %>%</strong> 사용 중 · 남은 공간 <strong><%= humanSize(info.disk.free) %></strong> / 전체 <%= humanSize(info.disk.total) %></p>
    <% if (info.alert) { %>
      <p class="error">디스크를 <%= info.ALERT_PERCENT %>% 넘게 쓰고 있습니다. 오래된 백업이나 서버의 다른 파일을 정리해야 합니다.</p>
    <% } else { %>
      <p class="muted"><%= info.ALERT_PERCENT %>% 를 넘으면 관리자에게 하루 한 번 알림이 갑니다.</p>
    <% } %>
  <% } else { %>
    <p class="muted">디스크 정보를 읽지 못했습니다.</p>
  <% } %>
</section>

<section class="card">
  <h2>인트라넷 데이터</h2>
  <dl class="info">
    <dt>DB</dt><dd><%= humanSize(info.db) %> <span class="muted small">(주문 <%= counts.orders.toLocaleString() %>줄 · 문의 <%= counts.inquiries.toLocaleString() %>건, 문의 본문 <%= humanSize(counts.inquiry_bytes) %>)</span></dd>
    <dt>백업</dt><dd><%= humanSize(info.backups.size) %> <span class="muted small">(<%= info.backups.count %>개<%= info.backups.latest ? ` · 최근 ${info.backups.latest}` : '' %>)</span></dd>
  </dl>
  <p class="muted small">백업은 매일 새벽 3시에 압축해서 저장하고 14일치를 보관합니다. 메일은 본문 글자만 저장하고 첨부파일은 저장하지 않습니다.</p>
</section>

<section class="card">
  <h2>목록에서 보여줄 기간 · 보관 기간</h2>
  <form method="post" action="/admin/storage/settings" class="settings-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>끝난 주문·답변한 문의를 목록에 보여줄 기간
      <select name="hide_done_days">
        <% HIDE_CHOICES.forEach(d => { %><option value="<%= d %>" <%= d === hideDays ? 'selected' : '' %>><%= d === 7 ? '1주' : d === 14 ? '2주' : d === 30 ? '1달' : '2달' %></option><% }) %>
      </select>
    </label>
    <p class="muted small">지나면 목록에서만 숨기고, <strong>월별 보기</strong>와 <strong>검색</strong>으로는 계속 찾을 수 있어요.</p>
    <label>주문 보관 기간
      <select name="keep_orders_months">
        <% KEEP_CHOICES.forEach(m => { %><option value="<%= m %>" <%= m === keepOrders ? 'selected' : '' %>><%= m < 12 ? `${m}개월` : `${m / 12}년` %></option><% }) %>
      </select>
    </label>
    <label>문의 보관 기간
      <select name="keep_inquiries_months">
        <% KEEP_CHOICES.forEach(m => { %><option value="<%= m %>" <%= m === keepInquiries ? 'selected' : '' %>><%= m < 12 ? `${m}개월` : `${m / 12}년` %></option><% }) %>
      </select>
    </label>
    <button type="submit" class="btn-sm">저장</button>
  </form>
</section>

<section class="card">
  <h2>오래된 자료 정리</h2>
  <p>보관 기간이 지난 <strong>끝난 주문 <%= preview.orders.toLocaleString() %>건</strong>(주문 <%= preview.orderMonths < 12 ? `${preview.orderMonths}개월` : `${preview.orderMonths / 12}년` %> 전)과
    <strong>답변한 문의 <%= preview.inquiries.toLocaleString() %>건</strong>(<%= preview.inquiryMonths < 12 ? `${preview.inquiryMonths}개월` : `${preview.inquiryMonths / 12}년` %> 전)을 지울 수 있어요.</p>
  <p class="muted small">진행 중인 주문, 취소·반품·교환 요청이 진행 중인 주문, 미답변 문의는 지우지 않아요. 처리 기록·답변 기록·톡톡 대화도 함께 지워져요.
    판매 채널(스마트스토어·쿠팡·자사몰 관리자)과 메일 사이트의 원본은 그대로 남아요. 지운 뒤 14일 안에는 백업으로 되살릴 수 있어요.</p>
  <% if (preview.orders || preview.inquiries) { %>
    <form method="post" action="/admin/storage/cleanup" data-once
          data-confirm="주문 <%= preview.orders %>건, 문의 <%= preview.inquiries %>건을 인트라넷에서 지울까요?&#10;되돌릴 수 없습니다.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="orders" value="<%= preview.orders %>">
      <input type="hidden" name="inquiries" value="<%= preview.inquiries %>">
      <button type="submit" class="btn-sm danger">🗑 지금 정리하기</button>
    </form>
  <% } %>
  <% if (log.length) { %>
    <h3>정리 기록</h3>
    <ul class="history">
      <% log.forEach(l => { %><li><%= kst(l.at) %> · <%= l.user || '-' %> · 주문 <%= l.orders %>건, 문의 <%= l.inquiries %>건</li><% }) %>
    </ul>
  <% } %>
</section>
<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
