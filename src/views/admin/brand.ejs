<%- include('../partials/header') %>
<%- include('../partials/admin-tabs') %>

<section class="card">
  <h2>회사 이름</h2>
  <form method="post" action="/admin/brand/name" class="settings-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>왼쪽 위·브라우저 탭·로그인 화면에 보이는 이름
      <input type="text" name="name" value="<%= brand.name %>" maxlength="<%= MAX_NAME %>" required>
    </label>
    <button type="submit" class="btn-sm">저장</button>
  </form>
</section>

<section class="card" id="proof">
  <h2>고객용 시안확정서 <span class="h2-sub">담당 디자이너 옆 연락처와 아래 약관</span></h2>
  <form method="post" action="/admin/brand/proof" class="settings-form proof-terms-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>연락처
      <input type="text" name="phone" value="<%= proofPhone %>" maxlength="30" placeholder="031-822-7815">
    </label>
    <% proofTerms.forEach((t, i) => { %>
      <fieldset class="term-box">
        <legend>약관 <%= i + 1 %>번 칸</legend>
        <label>제목
          <input type="text" name="term_title_<%= i %>" value="<%= t.title %>" maxlength="30">
        </label>
        <label><span>내용 <span class="muted small">(한 줄에 하나씩 · 12줄까지)</span></span>
          <textarea name="term_lines_<%= i %>" rows="<%= Math.max(3, t.lines.length + 3) %>"><%= t.lines.join('\n') %></textarea>
        </label>
      </fieldset>
    <% }) %>
    <button type="submit" class="btn-sm primary">저장</button>
  </form>
  <form method="post" action="/admin/brand/proof/reset" class="inline" data-confirm="연락처와 약관을 처음 문구로 되돌릴까요?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn-sm ghost">처음 문구로 되돌리기</button>
  </form>
</section>

<section class="card">
  <h2>로고</h2>
  <div class="brand-preview">
    <span class="muted small">지금 로고</span>
    <span class="brand"><% if (brand.logoUrl) { %><img class="brand-logo" src="<%= brand.logoUrl %>" alt="지금 로고"><% } else { %><span class="brand-mark" aria-hidden="true">B</span><% } %><%= brand.name %></span>
  </div>
  <form method="post" action="/admin/brand/logo" enctype="multipart/form-data" class="settings-form" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>새 로고 그림 (PNG·JPG·WEBP, 1MB 이하)
      <input type="file" name="logo" accept="image/png,image/jpeg,image/webp" required>
    </label>
    <p class="muted small">정사각형이나 가로로 조금 긴 그림이 잘 어울려요. 배경이 투명한 PNG 를 추천해요. 일러스트레이터 파일(AI·SVG)은 PNG 로 내보내서 올려 주세요.</p>
    <button type="submit" class="btn-sm">올리기</button>
  </form>
</section>

<section class="card" id="nav">
  <h2>왼쪽 메뉴 순서</h2>
  <p class="muted small">모든 직원에게 같은 순서로 보여요. 관리자 메뉴는 늘 맨 아래예요.</p>
  <ul class="rows">
    <% brand.navOrder.forEach((key, i) => { %>
      <li class="row">
        <span class="order"><%= i + 1 %></span>
        <span class="row-main"><strong><%= NAV_ITEMS[key] %></strong><% if (key === 'chat' && !chatOn) { %> <span class="muted small">(톡톡을 연결하면 보여요)</span><% } %></span>
        <span class="row-actions">
          <% [['up', '↑ 위로', i === 0], ['down', '↓ 아래로', i === brand.navOrder.length - 1]].forEach(([dir, label, off]) => { %>
            <form method="post" action="/admin/brand/nav" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="key" value="<%= key %>">
              <input type="hidden" name="dir" value="<%= dir %>">
              <button type="submit" class="btn-sm" <%= off ? 'disabled' : '' %> aria-label="<%= NAV_ITEMS[key] %> <%= label %>"><%= label %></button>
            </form>
          <% }) %>
        </span>
      </li>
    <% }) %>
  </ul>
</section>

<% if (brand.logoUrl || !brand.isDefaultName) { %>
<section class="card">
  <h2>처음으로 되돌리기</h2>
  <p class="muted small">이름을 '<%= DEFAULT_NAME %>' 으로, 로고를 B 로 되돌립니다.</p>
  <form method="post" action="/admin/brand/reset" data-once data-confirm="이름과 로고를 처음으로 되돌릴까요?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn-sm danger">처음으로 되돌리기</button>
  </form>
</section>
<% } %>
<script src="/confirm.js"></script>
<%- include('../partials/footer') %>
