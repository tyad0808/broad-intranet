<%- include('../partials/header') %>
<%
  // 지금 걸린 조건을 유지한 채 하나만 바꾼 주소
  const link = changes => {
    const p = new URLSearchParams();
    const merged = { box: box === defaultBox ? '' : box, tab: tab === defaultTab ? '' : tab, src, q, from, to, ...changes };
    for (const [k, v] of Object.entries(merged)) if (v) p.set(k, v);
    const s = p.toString();
    return s ? `/inbox?${s}` : '/inbox';
  };
%>
<% const practice = Object.entries(modes).filter(([, m]) => m !== 'live').map(([s]) => labelOf(s)); %>
<div class="page-head sticky-glass">
  <div class="title-row">
    <h1 class="page-title"><%= pageTitle %></h1>
    <%# 문의함의 큰 탭 (숫자는 미답변). 메일·톡톡은 왼쪽 메뉴 '메일함'·'톡톡' 으로 따로 %>
    <% if (box === 'shop' && inquiryBoxes.length > 1) { %>
    <nav class="box-tabs" aria-label="문의 종류" data-sortable data-url="/me/inbox-order" data-csrf="<%= csrfToken %>">
      <% inquiryBoxes.forEach(key => { %>
        <a href="<%= link({ box: key === defaultBox ? '' : key, src: '', tab: '', q: '', from: '', to: '' }) %>" class="<%= box === key ? 'on' : '' %>"
           draggable="true" data-key="<%= key %>" title="끌어서 순서를 바꿀 수 있습니다 (맨 앞 탭이 처음 열립니다)">
          <%= BOXES[key] %><% if (boxCounts[key]) { %> <span class="badge"><%= boxCounts[key] %></span><% } %>
        </a>
      <% }) %>
    </nav>
    <% } %>
  </div>
  <div class="page-actions">
    <% if (practice.length) { %>
      <span class="practice-pill" title="연습 모드: <%= practice.join(' · ') %> 답변을 보내도 실제로 나가지 않고 기록만 남깁니다.">연습 모드 <span class="muted"><%= practice.join(' · ') %></span></span>
    <% } %>
    <%# 톡톡은 바로 들어오고 답장은 파트너센터에서 해서 '답장 문구'·'지금 받기' 가 필요 없다 %>
    <% if (box !== 'chat') { %><a href="/templates" class="btn-sm ghost">답장 문구</a><% } %>
    <% if (canCollect && box !== 'chat') { %>
      <form method="post" action="/inbox/collect" class="collect-form" data-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= currentUrl %>">
        <% if (lastRun) { %><span class="muted small">마지막 <%= kst(lastRun.at).slice(11) %><%= lastRun.ok ? '' : ' (일부 실패)' %></span><% } %>
        <button type="submit" class="btn-sm ghost">↻ 지금 받기</button>
      </form>
    <% } %>
  </div>
</div>

<% if (noSources) { %>
  <section class="card"><p class="muted"><%= box === 'mail'
    ? '아직 연결된 메일이 없습니다. 서버의 .env 에 네이버메일·지메일 계정(앱 비밀번호)을 넣으면 여기로 모입니다.'
    : '아직 연결된 쇼핑몰 문의가 없습니다. 스마트스토어(ORDER_SOURCE=naver)를 쓰면 상품문의가 여기로 모입니다.' %></p></section>
<% } %>
<div id="live-tabs">
  <%# 출처(메일 계정·쇼핑몰) 알약 탭 %>
  <% if (sources.length > 1) { %>
    <nav class="channel-chips src-chips" aria-label="출처">
      <a href="<%= link({ src: '' }) %>" class="chip <%= src ? '' : 'on' %>">전체 출처</a>
      <% sources.forEach(s => { const n = sourceCounts[s] || 0; %>
        <a href="<%= link({ src: s }) %>" class="chip <%= src === s ? 'on' : '' %> <%= n ? '' : 'zero' %>"><span class="src-mark src-<%= s %>"></span><%= chipLabel(s) %> <span class="count"><%= n %></span></a>
      <% }) %>
    </nav>
  <% } %>
</div>

<%# 거르기: 보기(미답변·내 담당·답변완료·전체)·검색·기간. 새로 검색하면 '전체' 탭에서 찾는다 (탭은 넘기지 않음) %>
<form method="get" action="/inbox" class="filters" data-autosubmit>
  <% if (box !== defaultBox) { %><input type="hidden" name="box" value="<%= box %>"><% } %>
  <% if (src) { %><input type="hidden" name="src" value="<%= src %>"><% } %>
  <nav class="view-seg" id="live-views" aria-label="보기">
    <% Object.entries(TABS).forEach(([key, label]) => { %>
      <a href="<%= link({ tab: key === defaultTab ? '' : key }) %>" class="<%= tab === key ? 'on' : '' %>"><%= label %> <span class="count"><%= tabCounts[key] %></span></a>
    <% }) %>
  </nav>
  <input type="search" name="q" value="<%= q %>" placeholder="<%= box === 'mail' ? '제목, 내용, 보낸 사람, 메일 주소 검색' : '상품명, 문의 내용, 작성자, 주문번호 검색' %>" aria-label="검색">
  <button type="submit" class="btn-sm search-btn">검색</button>
  <input type="checkbox" id="more-filters" class="visually-hidden" <%= periodText ? 'checked' : '' %>>
  <label for="more-filters" class="btn-sm filters-more-toggle">기간<%= periodText ? ' · 1' : '' %> ▾</label>
  <div class="filters-more">
    <% if (q || periodText) { %><a href="<%= link({ q: '', from: '', to: '', tab: '' }) %>" class="btn-sm ghost" title="검색·기간 지우기">✕ 지우기</a><% } %>
    <div class="filters-period">
      <span class="chips-label">기간</span>
      <%- include('../partials/period-inputs', { from, to }) %>
      <%- include('../partials/period-quick', { quick, from, to, link: changes => link({ tab: '', ...changes }) }) %>
    </div>
  </div>
</form>
<% if (periodText) { %>
  <p class="muted small hide-note"><strong><%= periodText %></strong> 받은 문의를 답변한 것까지 모두 보여줍니다.</p>
<% } else if (hidingOld) { %>
  <p class="muted small hide-note">답변한 문의는 <%= hideDays %>일이 지나면 여기서 숨겨요. 지난 문의는 <strong>기간</strong>이나 <strong>검색</strong>으로 찾으세요.</p>
<% } %>
<% if (q && otherHits.length) { %>
  <p class="search-elsewhere muted small">다른 곳에도 있어요:
    <% otherHits.forEach(h => { %><a href="<%= link({ box: h.box === defaultBox ? '' : h.box, src: '', tab: '' }) %>"><%= BOXES[h.box] %> <%= h.n %>건</a> <% }) %>
  </p>
<% } %>

<form id="bulk-form" method="post" action="/inbox/bulk/close" data-once>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="back" value="<%= currentUrl %>">
</form>

<%# 넓은 화면: 왼쪽 목록 + 오른쪽 내용(누르면 이 칸에 열림). 좁은 화면은 목록만 (누르면 내용 화면으로) %>
<div class="inbox-split" data-inbox-split>
<div id="live-list" data-feed="inbox">
<%# 메일은 모든 줄을 체크할 수 있다 (삭제). 그 밖에는 미답변만 (처리 완료) %>
<% const canDelete = box === 'mail'; %>
<% const anyOpen = rows.some(r => r.status === 'open') || (canDelete && rows.length > 0); %>
<% if (anyOpen) { %>
  <div class="list-toolbar"><label class="check-all"><input type="checkbox" data-check-all> <%= canDelete ? '모두 선택' : '미답변 모두 선택' %></label></div>
<% } %>
<% if (rows.length === 0) { %>
  <% const filtered = q || periodText || src || tab !== defaultTab; %>
  <section class="card empty">
    <div class="empty-art" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H8.5L4 20z"/><path d="M8 9h8M8 12.5h5"/></svg></div>
    <p class="empty-title"><%= filtered ? (box === 'mail' ? '조건에 맞는 메일이 없어요' : '조건에 맞는 문의가 없어요') : (box === 'mail' ? '새 메일이 없어요' : '미답변 문의가 없어요') %></p>
    <p class="empty-text"><%= filtered ? '검색어나 기간을 바꿔 보세요.' : '새로 오면 여기에 바로 나타나요.' %><% if (hideDays && !periodText) { %> 답변한 <%= box === 'mail' ? '메일' : '문의' %>은 <%= hideDays %>일이 지나면 숨겨져요.<% } %></p>
    <div class="empty-actions">
      <% if (filtered) { %><a href="<%= link({ q: '', from: '', to: '', src: '', tab: 'all' }) %>" class="btn-sm">전체 보기</a><% } %>
    </div>
  </section>
<% } else { %>
  <ul class="order-list inbox-list">
    <% rows.forEach(r => { let files = []; try { files = JSON.parse(r.attachments || '[]'); } catch { files = []; } %>
      <li class="order-item inbox-item <%= r.status === 'open' ? 'unread' : '' %>">
        <% if (anyOpen) { %>
          <span class="oi-check">
            <% if (r.status === 'open' || canDelete) { %><input type="checkbox" name="ids" value="<%= r.id %>" form="bulk-form" data-can="<%= [r.status === 'open' ? 'close' : '', canDelete ? 'delete' : ''].join(' ').trim() %>" aria-label="선택: <%= r.subject %>"><% } %>
          </span>
        <% } %>
        <a class="oi-main" data-id="<%= r.id %>" href="/inbox/<%= r.id %>?back=<%= encodeURIComponent(currentUrl) %>">
          <div class="oi-head">
            <span class="src-tag src-<%= r.source %>"><%= labelOf(r.source) %></span>
            <span class="muted"><strong class="buyer"><% hl(r.from_name || r.from_addr || '-').forEach(p => { %><% if (p.hit) { %><mark><%= p.text %></mark><% } else { %><%= p.text %><% } %><% }) %></strong><% if (r.from_name && r.from_addr) { %> &lt;<%= r.from_addr %>&gt;<% } %> · <%= kst(r.received_at) %></span>
          </div>
          <div class="oi-name"><% hl(r.subject).forEach(p => { %><% if (p.hit) { %><mark><%= p.text %></mark><% } else { %><%= p.text %><% } %><% }) %><% if (files.length) { %> <span class="clip" title="첨부 <%= files.length %>개">📎<%= files.length %></span><% } %></div>
          <div class="muted inbox-preview"><%= r.preview_cut ? '…' : '' %><% hl((r.preview || '').replace(/\s+/g, ' ')).forEach(p => { %><% if (p.hit) { %><mark><%= p.text %></mark><% } else { %><%= p.text %><% } %><% }) %></div>
        </a>
        <div class="oi-meta">
          <form method="post" action="/inbox/<%= r.id %>/assign" class="inline" data-autosubmit>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= currentUrl %>">
            <select name="assignee_id" class="assign-select <%= r.assignee_id ? staffColor(r.assignee_id) : 'unassigned' %>" aria-label="담당자">
              <option value="">담당 미지정</option>
              <% staff.forEach(s => { %><option value="<%= s.id %>" <%= s.id === r.assignee_id ? 'selected' : '' %>><%= s.name %><%= s.id === user.id ? ' (나)' : '' %></option><% }) %>
            </select>
            <noscript><button type="submit" class="btn-sm">지정</button></noscript>
          </form>
          <span class="st-badge <%= r.status === 'open' ? 'sb-new' : r.status === 'answered' ? 'sb-done' : 'sb-wait' %>"><%= STATUS_LABELS[r.status] %></span>
        </div>
      </li>
    <% }) %>
  </ul>
  <% if (rows.length >= 300) { %><p class="muted">최근 300건까지만 보입니다. 검색이나 출처로 좁혀 보세요.</p><% } %>
<% } %>
</div>
<aside class="inbox-pane" aria-label="문의 내용">
  <iframe name="inbox-pane" title="문의 내용" hidden></iframe>
  <div class="pane-empty" data-pane-empty>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8.5L4 20z"/></svg>
    <p>왼쪽에서 문의를 고르면 여기에서 읽고 바로 답할 수 있어요.</p>
  </div>
</aside>
</div>

<div id="bulk-bar" class="bulk-bar" hidden>
  <span><strong data-bulk-count>0</strong>건 선택</span>
  <button type="submit" form="bulk-form" data-bulk-kind="close"
          data-confirm="체크한 문의를 '처리 완료'(답변 필요 없음)로 바꿀까요?&#10;메일로는 아무것도 보내지 않습니다.">처리 완료 <span data-n>0</span>건</button>
  <% if (box === 'mail') { %>
    <span class="bulk-sep" aria-hidden="true"></span>
    <button type="submit" form="bulk-form" formaction="/inbox/bulk/delete" class="danger" data-bulk-kind="delete"
            data-confirm="체크한 메일 {n}통을 인트라넷에서 삭제할까요?&#10;되돌릴 수 없습니다. (네이버메일·지메일의 원본은 그대로 남아요)">🗑 삭제 <span data-n>0</span>통</button>
  <% } %>
  <button type="button" class="btn-sm" data-bulk-clear>선택 해제</button>
</div>

<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<script src="/inbox-pane.js"></script>
<script src="/modal.js"></script>
<script src="/chip-order.js"></script>
<%- include('../partials/footer') %>
