<%- include('../partials/header') %>
<% if (!locals.embed) { %>
  <p class="back-row"><a href="<%= back %>" class="btn-back">← <%= isMail ? '메일함으로' : '문의함으로' %></a></p>
<% } %>
<% const backQs = back !== '/inbox' ? `?back=${encodeURIComponent(back)}` : ''; %>

<div class="detail" data-inquiry-id="<%= inquiry.id %>">
  <section class="card">
    <p class="detail-channel"><span class="src-tag src-<%= inquiry.source %>"><%= label %></span> <span class="pill <%= inquiry.status === 'open' ? 'wait' : 'light' %>"><%= STATUS_LABELS[inquiry.status] %></span></p>
    <h1 class="detail-title"><%= inquiry.subject %></h1>
    <dl class="info">
      <dt>보낸 사람</dt><dd><%= inquiry.from_name || '' %><% if (inquiry.from_addr) { %> &lt;<%= inquiry.from_addr %>&gt;<% } %></dd>
      <% if (inquiry.reply_to) { %><dt>답장 주소</dt><dd><%= inquiry.reply_to %></dd><% } %>
      <dt>받은 시각</dt><dd><%= kst(inquiry.received_at) %></dd>
      <% if (attachments.length) { %>
        <dt>첨부</dt>
        <dd>
          <% attachments.forEach((a, n) => { %>
            <div class="file-row">
              <% if (canOpenFiles) { %><a href="/inbox/<%= inquiry.id %>/files/<%= n %>">📎 <%= a.name %></a><% } else { %>📎 <%= a.name %><% } %>
              <span class="muted small">(<%= a.size >= 1024 * 1024 ? `${(a.size / 1024 / 1024).toFixed(1)}MB` : `${Math.max(1, Math.round(a.size / 1024))}KB` %>)</span>
            </div>
          <% }) %>
          <div class="muted small">눌러서 내려받습니다. 파일은 서버에 저장하지 않고 <%= label %>에서 그때그때 가져옵니다.</div>
        </dd>
      <% } %>
    </dl>
    <%# 본문은 글자로만 보여준다 (메일 속 스크립트·추적 이미지가 실행되지 않게) %>
    <% if (chat) { %>
      <%# 채팅: 고객은 왼쪽, 우리(파트너센터)는 오른쪽 말풍선 %>
      <div class="chat-thread">
        <% chat.forEach(m => { %>
          <div class="chat-msg <%= m.direction %>">
            <% if (m.kind === 'image' && m.image_url) { %>
              <a href="/inbox/<%= inquiry.id %>/chat-image/<%= m.id %>" target="_blank" rel="noopener"><img src="/inbox/<%= inquiry.id %>/chat-image/<%= m.id %>" alt="사진" loading="lazy"></a>
            <% } else { %>
              <div class="chat-text"><%= m.text %></div>
            <% } %>
            <span class="chat-time muted small"><%= m.direction === 'out' ? '우리 · ' : '' %><%= kst(m.created_at).slice(5) %></span>
          </div>
        <% }) %>
        <% if (!chat.length) { %><p class="muted">주고받은 말이 없습니다.</p><% } %>
      </div>
    <% } else { %>
    <div class="inquiry-body"><%= inquiry.body || '(내용 없음)' %></div>
    <% } %>
    <%# 그림 첨부 미리보기 (5MB 이하, 최대 6장) — 누르면 크게 %>
    <% const images = canOpenFiles ? attachments.map((a, n) => ({ ...a, n })).filter(a => previewType(a) && a.size <= 5 * 1024 * 1024).slice(0, 6) : []; %>
    <% if (images.length) { %>
      <div class="image-previews">
        <% images.forEach(a => { %>
          <a href="/inbox/<%= inquiry.id %>/files/<%= a.n %>?view=1" target="_blank" rel="noopener" title="<%= a.name %>">
            <img src="/inbox/<%= inquiry.id %>/files/<%= a.n %>?view=1" alt="<%= a.name %>" loading="lazy">
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="detail-side">
    <% if (!chat) { %><%- include('../partials/customer-history', { cust: customer, firstNote: '이 문의와 이어진 주문을 찾지 못했어요.' }) %><% } %>
    <section class="card process-card">
      <h2>답변</h2>
      <% if (chat) { %>
        <p class="practice-note">톡톡 답장은 지금처럼 <strong>톡톡 파트너센터</strong>에서 해 주세요. 보낸 답은 여기 대화에도 함께 쌓이고, 자동으로 '답변완료'가 됩니다.</p>
        <a class="btn-sm primary wide-link" href="<%= PARTNER_CENTER_URL %>" target="_blank" rel="noopener">톡톡 파트너센터 열기</a>
      <% } else if (mode !== 'live') { %>
        <p class="practice-note"><strong>연습 모드</strong> 보내기를 눌러도 <%= withRo(label) %> 나가지 않고 기록만 남깁니다.</p>
      <% } %>
      <form method="post" action="/inbox/<%= inquiry.id %>/assign" class="inline assign-row" data-autosubmit>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <input type="hidden" name="from" value="detail">
        <label>담당
          <select name="assignee_id" class="assign-select <%= inquiry.assignee_id ? staffColor(inquiry.assignee_id) : 'unassigned' %>">
            <option value="">담당 미지정</option>
            <% staff.forEach(s => { %><option value="<%= s.id %>" <%= s.id === inquiry.assignee_id ? 'selected' : '' %>><%= s.name %><%= s.id === user.id ? ' (나)' : '' %></option><% }) %>
          </select>
        </label>
        <noscript><button type="submit" class="btn-sm">지정</button></noscript>
      </form>

      <% const confirmText = isMail
           ? `${inquiry.reply_to || inquiry.from_addr} 에게 답변을 보낼까요?\n보낸 메일은 되돌릴 수 없습니다.`
           : `${label}에 이 답변을 등록할까요?\n고객에게 바로 보입니다.`; %>
      <% if (!chat) { %>
      <form method="post" action="/inbox/<%= inquiry.id %>/reply" class="reply-form" enctype="multipart/form-data" data-once
            data-confirm="<%= confirmText %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= back %>">
        <input type="hidden" name="version" value="<%= inquiry.version %>">
        <%# 자주 쓰는 답장 문구: 고르면 답장 칸에 들어간다 (그 뒤에 고쳐 써도 됨) %>
        <div class="template-row">
          <select data-template aria-label="답장 문구 넣기" data-csrf="<%= csrfToken %>">
            <option value=""><%= templates.length ? '＋ 자주 쓰는 문구 넣기' : '저장된 문구가 없어요' %></option>
            <% templates.forEach(t => { %><option value="<%= t.id %>" data-body="<%= t.body %>"><%= t.title %></option><% }) %>
          </select>
          <a href="/templates" target="_top" class="btn-sm ghost">문구 관리</a>
        </div>
        <% if (isMail) { %>
          <label>받는 사람 <span class="muted small"><%= inquiry.reply_to || inquiry.from_addr || '(주소 없음)' %></span>
            <textarea name="body" rows="8" maxlength="10000" required placeholder="답변 내용을 적어 주세요. 제목은 'Re: 원래 제목' 으로 보냅니다."></textarea>
          </label>
        <% } else { %>
          <label><%= label %> 문의 답변 <span class="muted small">(고객에게 그대로 보입니다)</span>
            <textarea name="body" rows="8" maxlength="10000" required placeholder="고객에게 보일 답변을 적어 주세요."></textarea>
          </label>
        <% } %>
        <%# 파일 첨부(메일만): 끌어다 놓거나 눌러서 고르기 (답변 칸에 놓아도 됨) %>
        <% if (isMail) { %>
        <div class="drop-zone" data-drop-zone>
          <input type="file" name="files" id="reply-files" multiple data-max-total="20971520" class="visually-hidden">
          <label for="reply-files" class="drop-hint">📎 파일을 여기로 끌어다 놓거나 <span class="link-like">눌러서 고르세요</span></label>
          <ul class="drop-list" data-drop-list></ul>
          <span class="muted small">합계 20MB까지 · 큰 파일은 웹하드 링크로 보내 주세요</span>
        </div>
        <% } %>
        <button type="submit" class="wide">답변 보내기</button>
      </form>
      <% } %>

      <div class="form-actions inquiry-actions">
        <% if (inquiry.status === 'open') { %>
          <form method="post" action="/inbox/<%= inquiry.id %>/close" class="inline" data-once>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= back %>">
            <button type="submit" class="btn-sm" title="광고·알림처럼 답변이 필요 없는 문의">답변 없이 완료</button>
          </form>
        <% } else { %>
          <form method="post" action="/inbox/<%= inquiry.id %>/reopen" class="inline" data-once>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= back %>">
            <button type="submit" class="btn-sm">다시 미답변으로</button>
          </form>
          <span class="muted small"><%= STATUS_LABELS[inquiry.status] %><%= inquiry.handled_name ? ` · ${inquiry.handled_name}` : '' %><%= inquiry.handled_at ? ` · ${kst(inquiry.handled_at)}` : '' %></span>
        <% } %>
        <% if (inquiry.order_no) { %><a class="btn-sm" href="/?view=all&q=<%= encodeURIComponent(inquiry.order_no) %>" target="_top">관련 주문 보기</a><% } %>
        <% if (isMail && inquiry.from_name) { %><a class="btn-sm" href="/?view=all&q=<%= encodeURIComponent(inquiry.from_name) %>" target="_top">이 이름으로 주문 찾기</a><% } %>
        <% if (isMail) { %>
          <form method="post" action="/inbox/<%= inquiry.id %>/delete" class="inline" data-once target="_top"
                data-confirm="이 메일을 인트라넷에서 삭제할까요?&#10;되돌릴 수 없습니다. (네이버메일·지메일의 원본은 그대로 남아요)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= back %>">
            <button type="submit" class="btn-sm danger">🗑 삭제</button>
          </form>
        <% } %>
      </div>

      <% if (replies.length) { %>
        <h3>답변 기록</h3>
        <ul class="history">
          <% replies.forEach(r => { %>
            <li>
              <span class="result r-<%= r.result %>"><%= RESULT_LABELS[r.result] %></span>
              <span class="muted">· <%= r.user_name || '-' %> · <%= kst(r.created_at) %></span>
              <% if (r.result !== 'ok') { %><div class="muted small"><%= r.message %></div><% } %>
              <div class="reply-body"><%= r.body %></div>
              <% let sentFiles = []; try { sentFiles = JSON.parse(r.attachments || '[]'); } catch { sentFiles = []; } %>
              <% if (sentFiles.length) { %><div class="muted small">📎 <%= sentFiles.map(f => f.name).join(', ') %></div><% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</div>
<script src="/confirm.js"></script>
<script src="/orders.js"></script>
<script src="/inbox.js"></script>
<%- include('../partials/footer') %>
