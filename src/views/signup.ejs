<%- include('partials/header') %>
<section class="card narrow">
  <h1>회원가입</h1>
  <p class="muted">가입 후 관리자가 승인해야 사용할 수 있습니다.</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/signup">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>이메일
      <input type="email" name="email" value="<%= form.email || '' %>" required autocomplete="username">
    </label>
    <label>이름
      <input type="text" name="name" value="<%= form.name || '' %>" required maxlength="30">
    </label>
    <label>별명 <span class="muted small">(선택 · 고객에게 보내는 시안확정서에 실명 대신 들어가요)</span>
      <input type="text" name="nickname" value="<%= form.nickname || '' %>" maxlength="20" placeholder="예: 디자이너 하늘">
    </label>
    <label>직무
      <select name="job_id">
        <option value="">선택 안 함</option>
        <% jobs.forEach(job => { %>
          <option value="<%= job.id %>" <%= form.job_id === job.id ? 'selected' : '' %>><%= job.name %></option>
        <% }) %>
      </select>
    </label>
    <label>비밀번호 (8자 이상)
      <input type="password" name="password" required minlength="8" autocomplete="new-password">
    </label>
    <label>비밀번호 확인
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
    </label>
    <button type="submit">가입 신청</button>
  </form>
  <p class="muted">이미 계정이 있나요? <a href="/login">로그인</a></p>
</section>
<%- include('partials/footer') %>
