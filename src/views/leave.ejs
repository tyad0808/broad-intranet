<%- include('partials/header') %>
<%# 휴가 (월차·연차): 1년 미만 매월 1개, 1년 이상 새해마다 정한 일수(기본 14), 반차 0.5개 (src/leave.js) %>
<% const d = n => fmtDays(n);
   const kindOf = r => KINDS[r.kind];
   const stTag = r => `<span class="lv-st lv-${r.status}">${STATUS[r.status]}</span>`; %>
<div class="page-head">
  <div class="title-row"><h1 class="page-title">휴가</h1><span class="page-sub">1년 미만은 한 달마다 1일, 1년 이상은 <%= yearlyMode === 'legal' ? '입사일마다 15일부터(2년마다 1일 더, 최대 25일)' : '관리자가 매년 넣어요' %> · 반차는 0.5일</span></div>
</div>

<%# ① 내 휴가 %>
<section class="lv-me" aria-label="내 휴가">
  <div class="lv-tile main">
    <span class="lv-label">내 남은 휴가</span>
    <strong class="lv-num"><%= d(me.left) %><small>일</small></strong>
    <span class="lv-sub"><% if (me.pending) { %>승인 대기 <%= d(me.pending) %>일 · 지금 신청할 수 있는 휴가 <%= d(Math.max(0, me.left - me.pending)) %>일<% } else if (me.left > 0) { %>이 일수 안에서 신청할 수 있어요<% } else { %>남은 휴가가 없어요. 관리자가 남은 일수를 넣어 주면 신청할 수 있어요<% } %></span>
  </div>
  <div class="lv-tile">
    <span class="lv-label">입사일</span>
    <% if (me.hireDate) { %>
      <strong class="lv-num small"><%= me.hireDate %></strong>
      <span class="lv-sub">근속 <%= me.service || '-' %></span>
    <% } else { %>
      <strong class="lv-num small muted">아직 없음</strong>
      <span class="lv-sub">관리자가 입사일을 넣으면 휴가가 저절로 생겨요</span>
    <% } %>
  </div>
  <div class="lv-tile">
    <span class="lv-label">다음에 생기는 휴가</span>
    <% if (me.next) { %>
      <strong class="lv-num small"><%= me.next.date %></strong>
      <span class="lv-sub"><%= me.next.label %> · +<%= me.next.days %>일</span>
    <% } else { %>
      <strong class="lv-num small muted">-</strong>
    <% } %>
  </div>
</section>

<div class="lv-grid">
  <%# ② 휴가 신청 %>
  <section class="card" id="apply">
    <h2>휴가 신청</h2>
    <form method="post" action="/leave" class="lv-form" data-once>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset class="lv-kinds">
        <legend>종류</legend>
        <% Object.entries(KINDS).forEach(([k, label], i) => { %>
          <label class="lv-kind"><input type="radio" name="kind" value="<%= k %>" <%= i === 0 ? 'checked' : '' %>><span><%= label %><small><%= k === 'full' ? '평일 1일씩' : '0.5일' %></small></span></label>
        <% }) %>
      </fieldset>
      <div class="lv-dates">
        <label>날짜 <input type="date" name="start_date" value="<%= today %>" required></label>
        <label class="lv-end">끝나는 날 <span class="muted small">(하루면 비워 두세요)</span><input type="date" name="end_date"></label>
      </div>
      <label>사유 <span class="muted small">(선택)</span><input type="text" name="reason" maxlength="200" placeholder="예) 개인 일정"></label>
      <p class="muted small">주말은 빼고 셉니다. 남은 휴가보다 많이는 신청할 수 없어요. 승인되면 회사 일정(달력)에 저절로 올라가요.</p>
      <div><button type="submit" class="btn-sm primary">휴가 신청</button></div>
    </form>
  </section>

  <%# ③ 내 신청 내역 %>
  <section class="card">
    <h2>내 신청 내역</h2>
    <% if (!mine.length) { %>
      <p class="muted">아직 신청한 휴가가 없어요.</p>
    <% } else { %>
      <ul class="lv-list">
        <% mine.forEach(r => { %>
          <li class="lv-row">
            <span class="lv-when"><strong><%= dateText(r) %></strong><span class="muted"><%= kindOf(r) %> · <%= d(r.days) %>일<%= r.reason ? ` · ${r.reason}` : '' %></span>
              <% if (r.decide_note) { %><span class="lv-note"><%= r.decider || '관리자' %>: <%= r.decide_note %></span><% } %></span>
            <%- stTag(r) %>
            <% if (r.status === 'pending') { %>
              <form method="post" action="/leave/<%= r.id %>/cancel" class="inline" data-confirm="<%= dateText(r) %> 휴가 신청을 취소할까요?" data-once>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-sm ghost">신청 취소</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<% if (manager) { %>
  <%# 관리자·부관리자: 승인·입사일·조정은 '휴가 관리' 화면에서 %>
  <a class="lv-manage-link" href="/admin/leave"><span><strong>휴가 관리</strong> · 승인, 직원별 입사일·남은 휴가, 일수 조정</span><% if (waitingCount) { %><span class="badge"><%= waitingCount %></span> 승인 대기<% } %><span class="more">열기 ›</span></a>
<% } %>

<script src="/leave.js"></script>
<%- include('partials/footer') %>
