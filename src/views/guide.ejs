<%- include('partials/header') %>
<div class="page-head sticky-glass">
  <div class="title-row"><h1 class="page-title">사용 방법</h1></div>
</div>
<div class="guide-layout">
  <nav class="card guide-toc" aria-label="안내서 차례">
    <strong>차례</strong>
