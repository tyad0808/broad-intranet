<%# 관리자 화면 공통 머리: 제목 + 묶음(직원·회사 / 주문 / 판매처·메일 / 기록·서버) + 그 묶음의 메뉴 (스크롤해도 위에 붙는다)
    메뉴가 많아서 비슷한 것끼리 4묶음으로 나눴다. 지금 화면이 든 묶음의 메뉴만 아래 줄에 보인다 %>
<% const ADMIN_GROUPS = [
     { key: 'people', label: '직원·회사', items: [
       ['users', '/admin/users', '직원 관리'], ['jobs', '/admin/jobs', '직무'], ['notices', '/admin/notices', '공지'],
       ['notify', '/admin/notify', '알림 설정'], ['brand', '/admin/brand', '회사·로고·매뉴얼']] },
     { key: 'orders', label: '주문', items: [
       ['stages', '/admin/stages', '작업 단계'], ['sources', '/admin/sources', '주문 출처'], ['columns', '/admin/columns', '주문 목록 칸'],
       ['collect', '/admin/collect', '주문 수집'], ['templates', '/templates', '답장 문구·매크로']] },
     { key: 'links', label: '판매처·메일 연결', items: [
       ['channels', '/admin/channels', '판매처 연결'], ['mail', '/admin/mail', '메일 계정'], ['logen', '/admin/logen', '로젠 설정']] },
     { key: 'system', label: '기록·서버', items: [
       ['actions', '/admin/actions', '처리 기록'], ['storage', '/admin/storage', '저장 공간']] },
   ];
   const current = ADMIN_GROUPS.find(g => g.items.some(([k]) => k === tab)) || ADMIN_GROUPS[0]; %>
<div class="page-head sticky-glass admin-head">
  <h1 class="page-title">관리자</h1>
  <nav class="admin-groups" aria-label="관리자 메뉴 묶음">
    <% ADMIN_GROUPS.forEach(g => { %>
      <a href="<%= g.items[0][1] %>" class="<%= g === current ? 'on' : '' %>" <%= g === current ? 'aria-current=true' : '' %>><%= g.label %><% if (g.key === 'people' && pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></a>
    <% }) %>
  </nav>
  <nav class="channel-chips admin-chips" aria-label="<%= current.label %> 메뉴">
    <% current.items.forEach(([key, href, label]) => { %>
      <a href="<%= href %>" class="chip <%= tab === key ? 'on' : '' %>"><%= label %><% if (key === 'users' && pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></a>
    <% }) %>
  </nav>
</div>
