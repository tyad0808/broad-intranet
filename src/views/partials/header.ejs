<!doctype html>
<% const brand = locals.brand || { name: '통합 어드민(브로애드)', logoUrl: null }; %>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title === '주문' ? brand.name : `${title} · ${brand.name}` %></title>
  <link rel="stylesheet" href="/fonts/pretendard/pretendard.css">
  <link rel="stylesheet" href="/style.css">
  <% if (brand.logoUrl) { %><link rel="icon" href="<%= brand.logoUrl %>" type="<%= brand.logoType %>"><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
</head>
<body<% if (locals.user && user.status === 'active') { %> data-user-id="<%= user.id %>"<% } %> class="<%= locals.embed ? 'embed' : locals.user && user.status === 'active' ? 'with-sidebar' : 'no-sidebar' %>">
  <% if (!locals.embed) { %>
  <%# 왼쪽 메뉴 (휴대폰에서는 위쪽 줄 + 아래쪽 탭) %>
  <%
    const icon = name => ({
      orders: '<path d="M4 6h16M4 12h16M4 18h10"/>',
      inbox: '<path d="M4 5h16v11H8.5L4 20z"/>',
      mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
      schedule: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
      admin: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
    })[name];
    const section = locals.navSection || 'orders';
  %>
  <aside class="sidebar">
    <a class="brand" href="/"><% if (brand.logoUrl) { %><img class="brand-logo" src="<%= brand.logoUrl %>" alt=""><% } else { %><span class="brand-mark" aria-hidden="true">B</span><% } %><span class="brand-name"><%= brand.name %></span></a>
    <% if (locals.user && user.status === 'active') { %>
      <nav class="main-nav" id="main-nav" aria-label="주요 메뉴">
        <%# 순서는 관리자 > 회사·로고 에서 정한다 %>
        <% const navItems = {
             orders: { href: '/', label: '주문', count: 0 },
             mail: { href: '/inbox?box=mail', label: '메일함', count: locals.openMails },
             inbox: { href: '/inbox', label: '문의함', count: locals.openInquiries },
             schedule: { href: '/schedule', label: '일정', count: 0 },
           };
           (brand.navOrder || Object.keys(navItems)).forEach(key => { const it = navItems[key]; if (!it) return; %>
          <a href="<%= it.href %>" class="<%= section === key ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon(key) %></svg><span><%= it.label %><% if (it.count > 0) { %> <span class="badge"><%= it.count %></span><% } %></span></a>
        <% }) %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users"<%- section === 'admin' ? "" : " target=\"_blank\" rel=\"noopener\"" %> class="<%= section === 'admin' ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon('admin') %></svg><span>관리자<% if (locals.pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></span></a>
        <% } %>
      </nav>
    <% } %>
    <% if (locals.user) { %>
      <div class="me">
        <%# 윈도우 알림(다른 창을 볼 때 오른쪽 아래에 뜨는 알림) 켜기 — 아직 안 켰거나 막혀 있을 때만 보인다 %>
        <div class="notify-card" id="notify-card" hidden>
          <strong>다른 창을 볼 때도 알림 받기</strong>
          <span class="muted small" data-notify-ask>새 주문·문의가 오면 화면 오른쪽 아래에 알려 드려요.</span>
          <span class="muted small" data-notify-denied hidden>알림이 막혀 있어요. 주소창 왼쪽 아이콘 → 사이트 설정 → 알림을 '허용'으로 바꿔 주세요.</span>
          <button type="button" id="enable-notify" class="btn-sm primary">알림 켜기</button>
        </div>
        <span class="me-name"><span class="avatar <%= staffColor(user.id) %>" aria-hidden="true"><%= String(user.name || '?').slice(0, 1) %></span><%= user.name %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="link" type="submit">로그아웃</button>
        </form>
      </div>
    <% } %>
  </aside>
  <% } %>
  <div class="page">
  <% if (!locals.embed && locals.unassignedAlert) { %>
    <a class="alert-bar" id="unassigned-bar" href="/?view=unassigned">
      담당 디자이너가 없는 주문이 <strong><%= unassignedAlert.count %>건</strong>이에요 (기준 <%= unassignedAlert.threshold %>건). 눌러서 확인하세요.
    </a>
  <% } %>
  <main class="container<%= locals.wide ? ' container-wide' : '' %>">
    <% if (locals.flash) { %>
      <div class="<%= flash.type === 'error' ? 'error' : flash.type === 'warn' ? 'warn-box' : 'notice' %> flash">
        <%= flash.message %>
        <% if (flash.details && flash.details.length) { %>
          <ul class="flash-details"><% flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
        <% } %>
      </div>
    <% } %>
