<!doctype html>
<% const brand = locals.brand || { name: '통합 어드민(브로애드)', logoUrl: null }; %>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title === '주문' ? brand.name : `${title} · ${brand.name}` %></title>
  <link rel="stylesheet" href="/style.css">
  <% if (brand.logoUrl) { %><link rel="icon" href="<%= brand.logoUrl %>" type="<%= brand.logoType %>"><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
</head>
<body<% if (locals.user && user.status === 'active') { %> data-user-id="<%= user.id %>"<% } %><% if (locals.embed) { %> class="embed"<% } %>>
  <% if (!locals.embed) { %>
  <header class="topbar">
    <a class="brand" href="/"><% if (brand.logoUrl) { %><img class="brand-logo" src="<%= brand.logoUrl %>" alt=""><% } else { %><span class="brand-mark" aria-hidden="true">B</span><% } %><%= brand.name %></a>
    <% if (locals.user && user.status === 'active') { %>
      <%# 주요 메뉴: 주문 / 문의함 (미답변 건수) %>
      <nav class="main-nav" id="main-nav">
        <a href="/" class="<%= locals.navSection === 'inbox' || locals.tab ? '' : 'on' %>">주문</a>
        <a href="/inbox" class="<%= locals.navSection === 'inbox' ? 'on' : '' %>">문의함<% if (locals.openInquiries > 0) { %> <span class="badge"><%= openInquiries %></span><% } %></a>
      </nav>
    <% } %>
    <% if (locals.user) { %>
      <nav class="me">
        <% if (user.role === 'admin' && user.status === 'active') { %>
          <a href="/admin/users"<%- locals.tab ? "" : " target=\"_blank\" rel=\"noopener\"" %>>관리자<% if (locals.pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></a>
        <% } %>
        <button type="button" id="enable-notify" class="link" hidden>알림 켜기</button>
        <span><%= user.name %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="link" type="submit">로그아웃</button>
        </form>
      </nav>
    <% } %>
  </header>
  <% if (locals.unassignedAlert) { %>
    <a class="alert-bar" id="unassigned-bar" href="/?view=unassigned">
      담당 디자이너가 없는 주문이 <strong><%= unassignedAlert.count %>건</strong>입니다 (기준 <%= unassignedAlert.threshold %>건). 눌러서 확인하세요.
    </a>
  <% } %>
  <% } %>
  <main class="container<%= locals.sideCalendar ? ' container-side' : '' %>">
    <% if (locals.flash) { %>
      <div class="<%= flash.type === 'error' ? 'error' : flash.type === 'warn' ? 'warn-box' : 'notice' %> flash">
        <%= flash.message %>
        <% if (flash.details && flash.details.length) { %>
          <ul class="flash-details"><% flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
        <% } %>
      </div>
    <% } %>
