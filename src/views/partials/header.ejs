<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 브로애드 인트라넷</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">브로애드 인트라넷</a>
    <% if (locals.user) { %>
      <nav class="me">
        <% if (user.role === 'admin' && user.status === 'active') { %>
          <a href="/admin/users">관리자<% if (locals.pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></a>
        <% } %>
        <span><%= user.name %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="link" type="submit">로그아웃</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main class="container">
    <% if (locals.flash) { %>
      <p class="<%= flash.type === 'error' ? 'error' : 'notice' %> flash"><%= flash.message %></p>
    <% } %>
