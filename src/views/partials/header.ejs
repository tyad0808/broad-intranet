<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 브로애드 인트라넷</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:,">
</head>
<body<% if (locals.user && user.status === 'active') { %> data-user-id="<%= user.id %>"<% } %>>
  <header class="topbar">
    <a class="brand" href="/">브로애드 인트라넷</a>
    <% if (locals.user) { %>
      <nav class="me">
        <% if (user.role === 'admin' && user.status === 'active') { %>
          <a href="/admin/users">관리자<% if (locals.pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></a>
        <% } %>
        <button type="button" id="enable-notify" class="link" hidden>알림 켜기</button>
        <span><%= user.name %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="link" type="submit">로그아웃</button>
        </form>
      </nav>
    <% } %>
  </header>
  <% if (locals.unassignedAlert) { %>
    <a class="alert-bar" id="unassigned-bar" href="/?view=unassigned">
      담당 디자이너가 없는 주문이 <strong><%= unassignedAlert.count %>건</strong>입니다 (기준 <%= unassignedAlert.threshold %>건). 눌러서 확인하세요.
    </a>
  <% } %>
  <main class="container<%= locals.sideCalendar ? ' container-side' : '' %>">
    <% if (locals.flash) { %>
      <div class="<%= flash.type === 'error' ? 'error' : flash.type === 'warn' ? 'warn-box' : 'notice' %> flash">
        <%= flash.message %>
        <% if (flash.details && flash.details.length) { %>
          <ul class="flash-details"><% flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
        <% } %>
      </div>
    <% } %>
