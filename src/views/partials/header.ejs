<!doctype html>
<% const brand = locals.brand || { name: '통합 어드민(브로애드)', logoUrl: null }; %>
<%# 화면 밝기: 직원이 고른 값 (없으면 자동 = 컴퓨터·휴대폰 설정 따라). 어둡게 색은 dark.css %>
<% const theme = locals.user && ['light', 'dark'].includes(user.theme) ? user.theme : 'auto';
   const THEME_LABEL = { auto: '자동', light: '밝게', dark: '어둡게' };
   const THEME_NEXT = { auto: 'light', light: 'dark', dark: 'auto' }; %>
<html lang="ko" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title === '주문' ? brand.name : `${title} · ${brand.name}` %></title>
  <link rel="stylesheet" href="/fonts/pretendard/pretendard.css">
  <meta name="color-scheme" content="<%= theme === 'auto' ? 'light dark' : theme %>">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/dark.css" id="dark-css" media="<%= theme === 'dark' ? 'all' : theme === 'light' ? 'not all' : '(prefers-color-scheme: dark)' %>">
  <% if (brand.logoUrl) { %><link rel="icon" href="<%= brand.logoUrl %>" type="<%= brand.logoType %>"><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
</head>
<body<% if (locals.user && user.status === 'active') { %> data-user-id="<%= user.id %>"<% if (Object.keys(locals.soundMap || {}).length) { %> data-sounds="<%= JSON.stringify(soundMap) %>"<% } %><% } %> class="<%= locals.embed ? 'embed' : locals.user && user.status === 'active' ? 'with-sidebar' : 'no-sidebar' %><%= locals.ds ? ' ds-v2' : '' %><%= locals.bodyClass ? ` ${bodyClass}` : '' %>">
  <% if (!locals.embed) { %>
  <%# 왼쪽 메뉴 (휴대폰에서는 위쪽 줄 + 아래쪽 탭) %>
  <%
    const icon = name => ({
      home: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/>',
      orders: '<path d="M4 6h16M4 12h16M4 18h10"/>',
      inbox: '<path d="M4 5h16v11H8.5L4 20z"/>',
      chat: '<path d="M12 4c4.97 0 9 3.13 9 7s-4.03 7-9 7c-.9 0-1.77-.1-2.6-.3L5 20l1.1-3.7C4.2 15 3 13.1 3 11c0-3.87 4.03-7 9-7z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/>',
      stats: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
      mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
      schedule: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
      leave: '<path d="M12 3a7 7 0 0 1 7 7H5a7 7 0 0 1 7-7z"/><path d="M12 10v9"/><path d="M9 21h6"/>',
      admin: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
    })[name];
    const section = locals.navSection || 'orders';
  %>
  <aside class="sidebar">
    <a class="brand" href="/home"><% if (brand.logoUrl) { %><img class="brand-logo" src="<%= brand.logoUrl %>" alt=""><% } else { %><span class="brand-mark" aria-hidden="true">B</span><% } %><span class="brand-name"><%= brand.name %></span></a>
    <% if (locals.user && user.status === 'active') { %>
      <nav class="main-nav" id="main-nav" aria-label="주요 메뉴">
        <%# 순서는 관리자 > 회사·로고 에서 정한다 %>
        <%# 홈(오늘 할 일)은 늘 맨 위 %>
        <div class="nav-row">
          <a href="/home" class="<%= section === 'home' ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon('home') %></svg><span>홈</span></a>
        </div>
        <% const navItems = {
             orders: { href: '/', label: '주문', count: locals.newOrders },
             mail: { href: '/inbox?box=mail', label: '메일함', count: locals.openMails },
             chat: locals.chatOn ? { href: '/inbox?box=chat', label: '톡톡', count: locals.openChats } : null,
             inbox: { href: '/inbox', label: '문의함', count: locals.openInquiries },
             schedule: { href: '/schedule', label: '일정', count: 0 },
             leave: { href: '/leave', label: '휴가', count: locals.pendingLeaves || 0 }, // 숫자: 관리자·부관리자에게 승인 대기
           };
           (brand.navOrder || Object.keys(navItems)).forEach(key => { const it = navItems[key]; if (!it) return; %>
          <%# 메일함·톡톡·문의함은 종 버튼으로 알림(숫자·새 소식)을 직원마다 끄고 켤 수 있다 %>
          <% const box = ['mail', 'chat', 'inbox'].includes(key) ? key : null; const off = box && (locals.notifyOff || []).includes(box); %>
          <div class="nav-row<%= off ? ' off' : '' %>">
          <a href="<%= it.href %>" class="<%= section === key ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon(key) %></svg><span><%= it.label %><% if (it.count > 0 && !off) { %> <span class="badge"><%= it.count %></span><% } %></span></a>
          <% if (box) { %>
            <form method="post" action="/me/notify/<%= box %>" class="nav-bell-form">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
              <input type="hidden" name="back" value="<%= locals.currentUrl || '/' %>">
              <button type="submit" class="nav-bell" aria-pressed="<%= off ? 'false' : 'true' %>"
                      title="<%= it.label %> 알림 <%= off ? '꺼짐 · 눌러서 켜기' : '켜짐 · 눌러서 끄기' %>" aria-label="<%= it.label %> 알림 <%= off ? '켜기' : '끄기' %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/><% if (off) { %><path d="M4 4l16 16"/><% } %></svg>
              </button>
            </form>
          <% } %>
          </div>
        <% }) %>
        <%# 통계는 관리자·부관리자, 관리자 설정은 관리자만 %>
        <% if (isManager(user)) { %>
          <a href="/stats" class="<%= section === 'stats' ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon('stats') %></svg><span>통계</span></a>
        <% } %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users" class="<%= section === 'admin' ? 'on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><%- icon('admin') %></svg><span>관리자<% if (locals.pendingCount > 0) { %> <span class="badge"><%= pendingCount %></span><% } %></span></a>
        <% } %>
      </nav>
      <%# 직원 사용 안내서 (docs/guide.md) %>
      <a href="/guide" class="nav-help<%= section === 'guide' ? ' on' : '' %>"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.6"/><path d="M12 17h.01"/></svg><span>사용 방법</span></a>
      <%# 견적·계산서 프로그램 (다른 사이트, 새 탭) %>
      <a href="https://quote.broadstore.co.kr/" target="_blank" rel="noopener" class="nav-help nav-ext" aria-label="견적/계산서 (새 탭)"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 16h5"/></svg><span>견적/계산서 <span class="nav-ext-mark" aria-hidden="true">↗</span></span></a>
      <%# 업무 매뉴얼 (노션 등, 관리자 › 회사·로고 에서 주소를 넣으면 보인다) %>
      <% if (locals.manualUrl) { %>
        <a href="<%= manualUrl %>" target="_blank" rel="noopener" class="nav-help nav-ext nav-manual" aria-label="업무 매뉴얼 (새 탭)"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/><path d="M9 7.5h6M9 11h4"/></svg><span>업무 매뉴얼 <span class="nav-ext-mark" aria-hidden="true">↗</span></span></a>
      <% } %>
    <% } %>
    <% if (locals.user) { %>
      <div class="me">
        <%# 윈도우 알림(다른 창을 볼 때 오른쪽 아래에 뜨는 알림) 켜기 — 아직 안 켰거나 막혀 있을 때만 보인다 %>
        <div class="notify-card" id="notify-card" hidden>
          <strong>다른 창을 볼 때도 알림 받기</strong>
          <span class="muted small" data-notify-ask>새 주문·문의가 오면 화면 오른쪽 아래에 알려 드려요.</span>
          <span class="muted small" data-notify-denied hidden>알림이 막혀 있어요. 주소창 왼쪽 아이콘 → 사이트 설정 → 알림을 '허용'으로 바꿔 주세요.</span>
          <button type="button" id="enable-notify" class="btn-sm primary">알림 켜기</button>
        </div>
        <span class="me-name"><span class="avatar <%= staffColor(user.id) %>" aria-hidden="true"><%= String(user.name || '?').slice(0, 1) %></span><%= user.name %></span>
        <%# 화면 밝기 버튼: 누를 때마다 자동 → 밝게 → 어둡게 (theme.js 가 바로 바꾸고 저장) %>
        <% if (user.status === 'active') { %>
        <form method="post" action="/me/theme" class="theme-form" data-theme-form>
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <input type="hidden" name="theme" value="<%= THEME_NEXT[theme] %>">
          <input type="hidden" name="back" value="<%= locals.pagePath || '/' %>">
          <button type="submit" class="theme-btn" title="화면 밝기: <%= THEME_LABEL[theme] %> (누르면 <%= THEME_LABEL[THEME_NEXT[theme]] %>)" aria-label="화면 밝기: <%= THEME_LABEL[theme] %>. 누르면 <%= THEME_LABEL[THEME_NEXT[theme]] %>">
            <svg class="theme-ico ti-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
            <svg class="theme-ico ti-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
            <svg class="theme-ico ti-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
            <span class="theme-label" data-theme-label><%= THEME_LABEL[theme] %></span>
          </button>
        </form>
        <% } %>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="link" type="submit">로그아웃</button>
        </form>
      </div>
    <% } %>
  </aside>
  <% } %>
  <div class="page">
  <% if (!locals.embed && locals.unassignedAlert) { %>
    <a class="alert-bar" id="unassigned-bar" href="/?view=unassigned">
      담당 디자이너가 없는 주문이 <strong><%= unassignedAlert.count %>건</strong>이에요 (기준 <%= unassignedAlert.threshold %>건). 눌러서 확인하세요.
    </a>
  <% } %>
  <main class="container<%= locals.wide ? ' container-wide' : '' %>">
    <% if (locals.flash) { %>
      <div class="<%= flash.type === 'error' ? 'error' : flash.type === 'warn' ? 'warn-box' : 'notice' %> flash">
        <%= flash.message %>
        <% if (flash.details && flash.details.length) { %>
          <ul class="flash-details"><% flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
        <% } %>
      </div>
    <% } %>
