<%# 기간 보기: 시작일 ~ 종료일 (달력에서 고름). 한쪽만 넣어도 된다 %>
<span class="period">
  <input type="date" name="from" value="<%= from %>" max="9999-12-31" aria-label="시작일" data-period>
  <span class="muted">~</span>
  <input type="date" name="to" value="<%= to %>" max="9999-12-31" aria-label="종료일" data-period>
</span>
