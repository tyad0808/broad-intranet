<%# 작업 단계·직무 공통 목록 편집기: 이름 바꾸기, 순서 바꾸기, 숨기기, 추가 %>
<ol class="rows">
  <% items.forEach((item, i) => { %>
    <li class="row <%= item.active ? '' : 'inactive' %>">
      <form method="post" action="<%= base %>/<%= item.id %>/rename" class="row-edit grow">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span class="order"><%= i + 1 %></span>
        <input type="text" name="name" value="<%= item.name %>" maxlength="30" required aria-label="이름">
        <button type="submit" class="btn-sm">이름 저장</button>
      </form>
      <div class="row-actions">
        <span class="muted"><%= countLabel(item) %></span>
        <% if (!item.active) { %><span class="status status-suspended">숨김</span><% } %>
        <% if (extra === 'designer') { %>
          <form method="post" action="<%= base %>/<%= item.id %>/designer" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-sm <%= item.is_designer ? 'primary' : '' %>">디자이너 목록 <%= item.is_designer ? '켜짐' : '꺼짐' %></button>
          </form>
        <% } %>
        <form method="post" action="<%= base %>/<%= item.id %>/move" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="dir" value="up">
          <button type="submit" class="btn-sm" <%= i === 0 ? 'disabled' : '' %> aria-label="위로">▲</button>
        </form>
        <form method="post" action="<%= base %>/<%= item.id %>/move" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="dir" value="down">
          <button type="submit" class="btn-sm" <%= i === items.length - 1 ? 'disabled' : '' %> aria-label="아래로">▼</button>
        </form>
        <form method="post" action="<%= base %>/<%= item.id %>/toggle" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-sm"><%= item.active ? '숨기기' : '다시 보이기' %></button>
        </form>
      </div>
    </li>
  <% }) %>
</ol>

<form method="post" action="<%= base %>" class="row-edit add-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="text" name="name" placeholder="새 이름" maxlength="30" required aria-label="새 이름">
  <button type="submit" class="btn-sm primary">추가</button>
</form>
